# CAMPUS AI Environment Configuration Template
PORT=3000
NODE_ENV=development

# ----------------------------------------------------
# Supabase Configuration
# ----------------------------------------------------
# Project URL (Found under Project Settings -> API)
SUPABASE_URL=

# Public Anon Key (Safe for frontend/client-side access)
SUPABASE_ANON_KEY=

# Service Role Key (Backend administrative access ONLY — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------
# Legacy / Fallback SQLite Database
# ----------------------------------------------------
DB_DIALECT=sqlite
DB_STORAGE=./campus_ai.sqlite

# ----------------------------------------------------
# Security & Sessions
# ----------------------------------------------------
JWT_SECRET=campus_ai_jwt_super_secret_key_2026
SESSION_SECRET=campus_ai_session_secret_aidex_2026
ADMIN_INVITE_CODE=CAMPUS_ADMIN_2026

# ----------------------------------------------------
# Google Gemini AI API Key
# ----------------------------------------------------
GEMINI_API_KEY=

# ----------------------------------------------------
# AI Code Lab Sandbox Execution Provider
# ----------------------------------------------------
CODE_EXECUTION_PROVIDER=local_sandbox
CODE_EXECUTION_API_KEY=

# ----------------------------------------------------
# Email Configuration (Nodemailer / SMTP)
# ----------------------------------------------------
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_PASSWORD=

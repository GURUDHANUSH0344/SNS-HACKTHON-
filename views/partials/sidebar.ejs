            <span class="nav-label">Directory</span>
          </a>
          <a href="/problems/new" class="nav-item <%= currentPath === '/problems/new' ? 'active' : '' %>" data-tooltip="Report Problem">
            <span class="nav-icon">🚨</span>
            <span class="nav-label">Report Issue</span>
            <span class="badge-ai">Auto</span>
          </a>
          <a href="/ai/notifications" class="nav-item <%= currentPath === '/ai/notifications' ? 'active' : '' %>" data-tooltip="Notifications">
            <span class="nav-icon">🔔</span>
            <span class="nav-label">Notifications</span>
          </a>
        </div>
      </div>
    <% } %>

    <!-- ================= UNIVERSAL FOOTER NAVIGATION ================= -->
    <% 
      let userProfileLink = '/student/profile';
      if (userRole === 'teacher' || userRole === 'faculty') userProfileLink = '/faculty/profile';
      else if (userRole === 'admin') userProfileLink = '/student/profile';
      const isPreferencesActive = currentPath === userProfileLink;
    %>

    <div class="nav-group <%= isPreferencesActive ? 'open' : '' %>" data-group-id="universal-preferences">
      <button type="button" class="nav-group-header" onclick="toggleNavGroup(this)">
        <span class="nav-group-title">PREFERENCES</span>
        <span class="nav-group-chevron">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </button>
      <div class="nav-group-items">
        <a href="<%= userProfileLink %>" class="nav-item <%= currentPath === userProfileLink ? 'active' : '' %>" data-tooltip="My Profile">
          <span class="nav-icon">👤</span>
          <span class="nav-label">Profile</span>
        </a>
        <button type="button" class="nav-item nav-item-btn" onclick="openModal('settingsModal')" data-tooltip="Interface Settings">
          <span class="nav-icon">⚙️</span>
          <span class="nav-label">Settings</span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Sidebar Footer Mini-Card & Collapse Toggle -->
  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <div class="sidebar-footer">
      <div class="user-mini-card">
        <a href="<%= userProfileLink %>" class="user-avatar-circle" title="View Profile (<%= currentUser.name %>)" aria-label="View Profile">
          <%= currentUser.name.charAt(0).toUpperCase() %>
        </a>
        <div class="user-mini-info">
          <div class="user-mini-name" title="<%= currentUser.name %>"><%= currentUser.name %></div>
          <div class="user-mini-role"><%= currentUser.role %></div>
        </div>
        <a href="/auth/logout" class="sidebar-logout-btn" title="Sign Out" aria-label="Sign Out">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
        </a>
      </div>

      <!-- Quick Toggle Collapse Button at bottom of sidebar -->
      <button class="sidebar-collapse-trigger" onclick="toggleSidebarCollapse()" title="Collapse / Expand Sidebar" aria-label="Toggle Sidebar Collapse">
        <span class="collapse-icon">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </span>
        <span class="collapse-text">Collapse Menu</span>
      </button>
    </div>
  <% } %>
</aside>

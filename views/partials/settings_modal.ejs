<!-- Global Settings Modal -->
<div class="modal-overlay" id="settingsModal">
  <div class="modal-card settings-modal-card">
    <div class="modal-header">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <span style="font-size: 1.25rem;">⚙️</span>
        <h3 class="modal-title">System & Interface Settings</h3>
      </div>
      <button class="modal-close" data-dismiss="modal" aria-label="Close Settings">✕</button>
    </div>

    <div class="modal-body settings-modal-body">
      <!-- Section 1: Appearance & Theme -->
      <div class="settings-section">
        <h4 class="settings-section-title">🎨 Appearance & Visual Theme</h4>
        <p class="settings-section-desc">CampusAI adheres to the official institutional blue-and-white university theme.</p>
        
        <div style="background: var(--primary-light); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1rem 1.25rem; display: flex; align-items: center; justify-content: space-between;">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div style="width: 28px; height: 28px; border-radius: 6px; background: var(--primary); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 0.9rem;">
              🏛️
            </div>
            <div>
              <div style="font-weight: 700; font-size: 0.875rem; color: var(--primary);">Institutional Blue & White</div>
              <div style="font-size: 0.75rem; color: var(--text-secondary);">High-contrast, accessible university standard palette</div>
            </div>
          </div>
          <span class="badge" style="background: var(--success-light); color: var(--success); font-weight: 700; font-size: 0.72rem;">ACTIVE</span>
        </div>
      </div>

      <!-- Section 2: Sidebar & Navigation Preferences -->
      <div class="settings-section">
        <h4 class="settings-section-title">📐 Sidebar Layout</h4>
        <p class="settings-section-desc">Choose your preferred workspace navigation density.</p>
        
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <button type="button" class="btn btn-secondary btn-sm" onclick="setSidebarCollapsed(false)">
            ↔️ Expanded (260px)
          </button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="setSidebarCollapsed(true)">
            ⬅️ Compact Collapsed (78px)
          </button>
        </div>
      </div>

      <!-- Section 3: AI Preferences -->
      <div class="settings-section">
        <h4 class="settings-section-title">🤖 AI Assistant Preferences</h4>
        <p class="settings-section-desc">Fine-tune the behavior of CampusAI neural recommendations.</p>

        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <label style="display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem; cursor: pointer;">
            <div>
              <strong>Streaming Micro-Animations</strong>
              <div style="font-size: 0.75rem; color: var(--text-muted);">Simulate real-time cognitive typing in chat widgets</div>
            </div>
            <input type="checkbox" id="prefAiStreaming" checked />
          </label>

          <label style="display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem; cursor: pointer;">
            <div>
              <strong>Explainable AI Metrics</strong>
              <div style="font-size: 0.75rem; color: var(--text-muted);">Show underlying mathematical contributing factors on prediction cards</div>
            </div>
            <input type="checkbox" id="prefAiExplainable" checked />
          </label>
        </div>
      </div>

      <!-- Section 4: Notifications -->
      <div class="settings-section" style="border-bottom: none; margin-bottom: 0; padding-bottom: 0;">
        <h4 class="settings-section-title">🔔 Alert Preferences</h4>
        <p class="settings-section-desc">Control automated threshold warnings.</p>

        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <label style="display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem; cursor: pointer;">
            <div>
              <strong>Attendance Shortfall Critical Alerts</strong>
              <div style="font-size: 0.75rem; color: var(--text-muted);">Immediate portal notification when attendance falls below 75%</div>
            </div>
            <input type="checkbox" checked disabled />
          </label>

          <label style="display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem; cursor: pointer;">
            <div>
              <strong>Audio Toast Chimes</strong>
              <div style="font-size: 0.75rem; color: var(--text-muted);">Play subtle audio feedback on ticket updates</div>
            </div>
            <input type="checkbox" id="prefAudioChime" />
          </label>
        </div>
      </div>
    </div>

    <div class="modal-footer">
      <button type="button" class="btn btn-primary btn-sm" data-dismiss="modal" onclick="showToast('Settings saved successfully', 'success')">
        Done
      </button>
    </div>
  </div>
</div>

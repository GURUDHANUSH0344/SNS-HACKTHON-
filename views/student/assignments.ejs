<%- include('../partials/head', { pageTitle: 'Assignments & Submissions — CAMPUS AI' }) %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/navbar') %>

    <main class="content-container">
      <div class="page-header">
        <div>
          <h1 class="page-title">Course Assignments & Digital Submissions</h1>
          <p class="page-subtitle">Academic Problem Sets, Code Submissions, and Faculty Feedback</p>
        </div>
      </div>

      <div class="table-container">
        <div class="table-header-tools">
          <span style="font-weight: 600; font-size: 0.875rem;">Published Coursework (<%= assignments.length %>)</span>
          <span style="font-size: 0.75rem; color: var(--text-muted);">Submit online with text answers and file attachments</span>
        </div>

        <% if (assignments && assignments.length > 0) { %>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th style="width: 17%;">Subject</th>
                  <th>Assignment</th>
                  <th style="width: 11%;">Due Date</th>
                  <th style="width: 9%;">Points</th>
                  <th style="width: 12%;">Status</th>
                  <th style="width: 12%;">Score</th>
                  <th style="width: 11%; text-align: right;">Action</th>
                </tr>
              </thead>
              <tbody>
                <% assignments.forEach(asg => { %>
                  <% const sub = submittedMap[asg.id]; %>
                  <tr>
                    <td>
                      <div style="font-weight: 600; color: var(--text-main);"><%= asg.subjectName %></div>
                      <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 2px;"><%= asg.unit %> • <%= asg.difficulty %></div>
                    </td>
                    <td>
                      <div style="font-weight: 600; font-size: 0.84rem; color: var(--text-main);"><%= asg.title %></div>
                      <div style="font-size: 0.75rem; color: var(--text-secondary); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 2px;"><%= asg.description %></div>
                    </td>
                    <td style="white-space: nowrap;">
                      <div style="font-weight: 500; font-size: 0.8125rem;"><%= asg.dueDate %></div>
                    </td>
                    <td style="white-space: nowrap; font-size: 0.8125rem;">
                      <%= asg.maxScore %> Pts
                    </td>
                    <td>
                      <% if (sub) { %>
                        <span class="status-pill status-<%= sub.status === 'Graded' ? 'paid' : 'inprogress' %>">
                          <%= sub.status %>
                        </span>
                      <% } else { %>
                        <span class="status-pill status-unpaid">Pending</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (sub && sub.score !== null) { %>
                        <strong style="color: var(--primary);"><%= sub.score %></strong> / <%= asg.maxScore %>
                        <% if (sub.feedback) { %>
                          <div style="font-size: 0.72rem; color: var(--text-muted); font-style: italic; margin-top: 2px;">"<%= sub.feedback %>"</div>
                        <% } %>
                      <% } else if (sub) { %>
                        <span style="font-size: 0.75rem; color: var(--text-muted);">Awaiting Review</span>
                      <% } else { %>
                        <span style="font-size: 0.75rem; color: var(--text-muted);">—</span>
                      <% } %>
                    </td>
                    <td style="text-align: right;">
                      <button type="button" onclick="openSubmitModal('<%= asg.id %>', '<%= asg.title %>', '<%= asg.subjectName %>', '<%= sub ? sub.submissionText || '' : '' %>')" class="btn <%= sub ? 'btn-secondary' : 'btn-primary' %> btn-sm" style="white-space: nowrap;">
                        <%= sub ? '✏️ Update' : '📤 Submit' %>
                      </button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">
            <div class="empty-icon">📂</div>
            <div class="empty-title">No Assignments Due</div>
            <p class="empty-text">No active assignments have been posted by your course faculty.</p>
          </div>
        <% } %>
      </div>

    </main>
  </div>
</div>

<!-- Submit Assignment Modal -->
<div class="modal-overlay" id="submitModal">
  <div class="modal-card">
    <div class="modal-header">
      <h3 class="modal-title">Submit Assignment Solution</h3>
      <button class="modal-close" data-dismiss="modal">✕</button>
    </div>
    <form id="submitAssignmentForm" method="POST" enctype="multipart/form-data">
      <div class="modal-body">
        <div style="background: #f8fafc; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.85rem; margin-bottom: 1.25rem;">
          <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600;" id="modalSubject"></span>
          <div style="font-size: 1rem; font-weight: 700; color: var(--primary); margin-top: 0.2rem;" id="modalTitle"></div>
        </div>

        <div class="form-group">
          <label class="form-label">Solution Text / Code Submission</label>
          <textarea id="modalSubmissionText" name="submissionText" class="form-control" style="min-height: 120px;" placeholder="Provide your answers, algorithm explanation, or code link..."></textarea>
        </div>

        <div class="form-group">
          <label class="form-label">Attach File (PDF / ZIP / Code / Document)</label>
          <input type="file" name="attachment" class="form-control" />
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Submit for Grading</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openSubmitModal(id, title, subject, existingText) {
    document.getElementById('submitAssignmentForm').action = `/student/assignments/${id}/submit`;
    document.getElementById('modalTitle').textContent = title;
    document.getElementById('modalSubject').textContent = subject;
    document.getElementById('modalSubmissionText').value = existingText || '';
    openModal('submitModal');
  }
</script>

<%- include('../partials/footer') %>

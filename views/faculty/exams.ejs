<%- include('../partials/head', { pageTitle: 'Exams & Marks Entry — CAMPUS AI' }) %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/navbar') %>

    <main class="content-container">
      <div class="page-header">
        <div>
          <h1 class="page-title">Exams & Continuous Assessment Marks Entry</h1>
          <p class="page-subtitle">Internal Evaluations, Model Practical Tests, and Semester Final Grades</p>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem;">
        
        <!-- Marks Entry Form -->
        <div class="card">
          <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 1rem; color: var(--primary);">
            📝 Record Student Marks
          </h3>
          <form action="/exams" method="POST">
            <div class="form-group">
              <label class="form-label">Student</label>
              <select name="studentId" class="form-control" required>
                <% students.forEach(st => { %>
                  <option value="<%= st.id %>"><%= st.name %> (<%= st.studentId %>)</option>
                <% }) %>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Subject</label>
              <select name="subjectName" class="form-control" required>
                <% subjects.forEach(sub => { %>
                  <option value="<%= sub.name %>"><%= sub.name %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Evaluation Type</label>
              <select name="examType" class="form-control" required>
                <option value="Continuous Assessment 1">Continuous Assessment 1</option>
                <option value="Mid Term Exam">Mid Term Exam</option>
                <option value="Model Practical Test">Model Practical Test</option>
                <option value="End Semester Final">End Semester Final</option>
              </select>
            </div>

            <div class="form-group" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
              <div>
                <label class="form-label">Marks Obtained</label>
                <input type="number" step="0.5" name="marksObtained" class="form-control" placeholder="85" required />
              </div>
              <div>
                <label class="form-label">Max Marks</label>
                <input type="number" name="maxMarks" class="form-control" value="100" required />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Remarks</label>
              <input type="text" name="remarks" class="form-control" placeholder="Well done, strong grasp of algorithms" />
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">
              Save & Compute Grade
            </button>
          </form>
        </div>

        <!-- Recent Records -->
        <div class="card">
          <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 1rem;">
            📊 Recently Logged Examination Scores
          </h3>
          <% if (exams && exams.length > 0) { %>
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Student</th>
                    <th>Subject</th>
                    <th>Score</th>
                    <th>Grade</th>
                    <th>Exam Type</th>
                  </tr>
                </thead>
                <tbody>
                  <% exams.forEach(ex => { %>
                    <tr>
                      <td>
                        <strong><%= ex.student ? ex.student.name : 'Student #' + ex.studentId %></strong>
                      </td>
                      <td><%= ex.subjectName %></td>
                      <td><strong><%= ex.marksObtained %></strong> / <%= ex.maxMarks %> (<%= ex.percentage %>%)</td>
                      <td><span class="status-pill status-paid"><%= ex.grade %></span></td>
                      <td><%= ex.examType %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <p style="font-size: 0.8125rem; color: var(--text-muted);">No records found.</p>
          <% } %>
        </div>

      </div>

    </main>
  </div>
</div>

<%- include('../partials/footer') %>

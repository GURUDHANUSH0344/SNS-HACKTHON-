<%- include('../partials/head', { pageTitle: 'Assignments & Grading Cell — CAMPUS AI' }) %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/navbar') %>

    <main class="content-container">
      <div class="page-header">
        <div>
          <h1 class="page-title">Assignments & Submissions Grading Cell</h1>
          <p class="page-subtitle">Continuous Academic Assessment, Student Code Submissions, and Feedback</p>
        </div>
        <div>
          <button type="button" onclick="openModal('createAssignmentModal')" class="btn btn-primary btn-sm">
            + Create Assignment
          </button>
        </div>
      </div>

      <!-- Published Assignments List -->
      <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <% assignments.forEach(asg => { %>
          <% const submissions = asg.submissions || []; %>
          <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <div>
                <span class="status-pill status-inprogress" style="margin-bottom: 0.35rem;"><%= asg.unit %> • <%= asg.difficulty %></span>
                <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--text-main); margin-top: 0.2rem;"><%= asg.title %></h3>
                <p style="font-size: 0.8125rem; color: var(--primary); font-weight: 600;"><%= asg.subjectName %></p>
              </div>
              <div style="text-align: right;">
                <div style="font-size: 0.8125rem; color: var(--text-muted);">Due Date: <strong><%= asg.dueDate %></strong></div>
                <div style="font-size: 0.8125rem; color: var(--text-muted);">Max Score: <strong><%= asg.maxScore %> Pts</strong></div>
              </div>
            </div>

            <p style="font-size: 0.875rem; color: var(--text-secondary); margin-bottom: 1rem; line-height: 1.5;">
              <%= asg.description %>
            </p>

            <!-- Submissions Table -->
            <div style="border-top: 1px solid var(--border); padding-top: 1rem;">
              <h4 style="font-size: 0.875rem; font-weight: 700; margin-bottom: 0.5rem;">
                Student Submissions Received (<%= submissions.length %>)
              </h4>

              <% if (submissions.length > 0) { %>
                <div class="table-responsive">
                  <table class="data-table">
                    <thead>
                      <tr>
                        <th>Student</th>
                        <th>Submission</th>
                        <th>File</th>
                        <th>Submitted</th>
                        <th>Status</th>
                        <th>Score</th>
                        <th style="text-align: right;">Action</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% submissions.forEach(sub => { %>
                        <tr>
                          <td>
                            <strong><%= sub.student ? sub.student.name : 'Student #' + sub.studentId %></strong>
                            <div style="font-size: 0.72rem; color: var(--text-muted);"><%= sub.student ? sub.student.studentId : '' %></div>
                          </td>
                          <td style="font-size: 0.8125rem; max-width: 250px;">
                            <%= sub.submissionText ? sub.submissionText.slice(0, 75) + '...' : 'Uploaded file' %>
                          </td>
                          <td>
                            <% if (sub.fileUrl) { %>
                              <a href="<%= sub.fileUrl %>" target="_blank" class="btn btn-secondary btn-sm" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;">
                                📄 Download
                              </a>
                            <% } else { %>
                              <span style="font-size: 0.75rem; color: var(--text-muted);">None</span>
                            <% } %>
                          </td>
                          <td style="font-size: 0.75rem;"><%= new Date(sub.submittedAt).toLocaleDateString('en-IN') %></td>
                          <td>
                            <span class="status-pill status-<%= sub.status === 'Graded' ? 'paid' : 'inprogress' %>">
                              <%= sub.status %>
                            </span>
                          </td>
                          <td>
                            <% if (sub.score !== null) { %>
                              <strong style="color: var(--primary);"><%= sub.score %></strong> / <%= asg.maxScore %>
                            <% } else { %>
                              <span style="color: var(--warning);">Ungraded</span>
                            <% } %>
                          </td>
                          <td>
                            <button type="button" onclick="openGradeModal('<%= sub.id %>', '<%= sub.student ? sub.student.name : 'Student' %>', '<%= asg.title %>', '<%= asg.maxScore %>', '<%= sub.score || '' %>', '<%= sub.feedback || '' %>')" class="btn btn-primary btn-sm">
                              🎯 Grade
                            </button>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <p style="font-size: 0.8125rem; color: var(--text-muted); padding: 0.5rem 0;">
                  No student submissions received for this assignment yet.
                </p>
              <% } %>
            </div>

            <div style="display: flex; justify-content: flex-end; margin-top: 1rem; padding-top: 0.5rem; border-top: 1px dashed var(--border);">
              <form action="/faculty/assignments/<%= asg.id %>/delete" method="POST" style="margin:0;" onsubmit="return confirm('Delete assignment and all submissions?');">
                <button type="submit" class="btn btn-secondary btn-sm" style="color: var(--danger);">
                  🗑️ Delete Assignment
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>

    </main>
  </div>
</div>

<!-- Create Assignment Modal -->
<div class="modal-overlay" id="createAssignmentModal">
  <div class="modal-card">
    <div class="modal-header">
      <h3 class="modal-title">Create New Academic Assignment</h3>
      <button class="modal-close" data-dismiss="modal">✕</button>
    </div>
    <form action="/faculty/assignments" method="POST">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Course Subject</label>
          <select name="subjectName" class="form-control" required>
            <% subjects.forEach(sub => { %>
              <option value="<%= sub.name %>"><%= sub.name %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Assignment Title</label>
          <input type="text" name="title" class="form-control" placeholder="e.g. Graph Traversal & Shortest Path Algorithms" required />
        </div>

        <div class="form-group">
          <label class="form-label">Detailed Problem Description & Rubric</label>
          <textarea name="description" class="form-control" placeholder="Provide problem specifications, constraints, and test scenarios..." required></textarea>
        </div>

        <div class="form-group" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
          <div>
            <label class="form-label">Curriculum Unit</label>
            <input type="text" name="unit" class="form-control" value="Unit 2" required />
          </div>
          <div>
            <label class="form-label">Max Score</label>
            <input type="number" name="maxScore" class="form-control" value="100" required />
          </div>
          <div>
            <label class="form-label">Difficulty</label>
            <select name="difficulty" class="form-control">
              <option value="Easy">Easy</option>
              <option value="Medium" selected>Medium</option>
              <option value="Hard">Hard</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Submission Due Date</label>
          <input type="date" name="dueDate" class="form-control" value="<%= new Date(Date.now() + 7 * 86400000).toISOString().slice(0, 10) %>" required />
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Publish Assignment</button>
      </div>
    </form>
  </div>
</div>

<!-- Grade Submission Modal -->
<div class="modal-overlay" id="gradeModal">
  <div class="modal-card">
    <div class="modal-header">
      <h3 class="modal-title">Grade Student Submission</h3>
      <button class="modal-close" data-dismiss="modal">✕</button>
    </div>
    <form id="gradeForm" method="POST">
      <div class="modal-body">
        <div style="background: #f8fafc; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.85rem; margin-bottom: 1.25rem;">
          <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Grading Candidate</div>
          <div style="font-size: 1rem; font-weight: 700; color: var(--primary);" id="gradeStudentName"></div>
          <div style="font-size: 0.8125rem; color: var(--text-secondary); margin-top: 0.2rem;" id="gradeAssignmentTitle"></div>
        </div>

        <div class="form-group">
          <label class="form-label">Score Awarded (Out of <span id="gradeMaxScore"></span>)</label>
          <input type="number" step="0.5" id="gradeScoreInput" name="score" class="form-control" required />
        </div>

        <div class="form-group">
          <label class="form-label">Faculty Feedback & Growth Notes</label>
          <textarea id="gradeFeedbackInput" name="feedback" class="form-control" placeholder="Constructive feedback, code optimization advice..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Submit Grade</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openGradeModal(submissionId, studentName, asgTitle, maxScore, currentScore, currentFeedback) {
    document.getElementById('gradeForm').action = `/faculty/assignments/submissions/${submissionId}/grade`;
    document.getElementById('gradeStudentName').textContent = studentName;
    document.getElementById('gradeAssignmentTitle').textContent = asgTitle;
    document.getElementById('gradeMaxScore').textContent = maxScore;
    document.getElementById('gradeScoreInput').value = currentScore || '';
    document.getElementById('gradeFeedbackInput').value = currentFeedback || '';
    openModal('gradeModal');
  }
</script>

<%- include('../partials/footer') %>

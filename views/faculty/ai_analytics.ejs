<%- include('../partials/head', { pageTitle: 'AI Academic Analytics — CAMPUS AI' }) %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/navbar') %>

    <main class="content-container">
      <div class="page-header">
        <div>
          <h1 class="page-title">AI Student Performance Diagnostics & Early Warning</h1>
          <p class="page-subtitle">Multivariate Neural Diagnostics Detecting Learning Friction, Attendance Lag, and Intervention Priorities</p>
        </div>
      </div>

      <!-- Overview Cards -->
      <div class="grid-cards">
        <div class="card stat-card">
          <div class="stat-info">
            <span>Diagnosed Cohort</span>
            <h2><%= aiDiagnostics.length %></h2>
            <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">Active Students Assessed</p>
          </div>
          <div class="stat-icon blue">👥</div>
        </div>

        <div class="card stat-card">
          <div class="stat-info">
            <span>Critical Priority</span>
            <h2 style="color: var(--danger);"><%= aiDiagnostics.filter(d => d.riskLevel === 'Critical').length %></h2>
            <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">Immediate Remedial Action</p>
          </div>
          <div class="stat-icon red">🚨</div>
        </div>

        <div class="card stat-card">
          <div class="stat-info">
            <span>Moderate Watchlist</span>
            <h2 style="color: var(--warning);"><%= aiDiagnostics.filter(d => d.riskLevel === 'High' || d.riskLevel === 'Medium').length %></h2>
            <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">Attendance / Marks Alert</p>
          </div>
          <div class="stat-icon amber">⚠️</div>
        </div>

        <div class="card stat-card">
          <div class="stat-info">
            <span>Optimal Standing</span>
            <h2 style="color: var(--success);"><%= aiDiagnostics.filter(d => d.riskLevel === 'Low').length %></h2>
            <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">Self-Sustaining Progress</p>
          </div>
          <div class="stat-icon green">✅</div>
        </div>
      </div>

      <!-- Diagnostic Table -->
      <div class="table-container">
        <div class="table-header-tools">
          <span style="font-weight: 600; font-size: 0.875rem;">AI Student Triage Register</span>
          <span style="font-size: 0.75rem; color: var(--text-muted);">Explainable risk reasoning with prioritized faculty intervention recommendations</span>
        </div>

        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Student ID & Name</th>
                <th>Course Cohort</th>
                <th>Risk Level</th>
                <th>Diagnostic Risk Score</th>
                <th>Contributing Risk Factors</th>
                <th>Recommended Faculty Intervention</th>
              </tr>
            </thead>
            <tbody>
              <% aiDiagnostics.forEach(st => { %>
                <tr>
                  <td>
                    <div style="font-weight: 600;"><%= st.name %></div>
                    <div class="font-mono" style="font-size: 0.75rem; color: var(--primary);"><%= st.studentId %></div>
                  </td>
                  <td><%= st.course %> (Yr <%= st.year %>)</td>
                  <td>
                    <span class="status-pill status-<%= st.riskLevel.toLowerCase() %>">
                      <%= st.riskLevel %> Priority
                    </span>
                  </td>
                  <td>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                      <div style="width: 70px; height: 6px; background: #e2e8f0; border-radius: 999px;">
                        <div style="width: <%= st.riskScore %>%; height: 6px; border-radius: 999px; background: <%= st.riskLevel === 'Critical' ? 'var(--danger)' : st.riskLevel === 'High' ? 'var(--warning)' : 'var(--primary)' %>;"></div>
                      </div>
                      <span style="font-weight: 700; font-size: 0.8125rem;"><%= st.riskScore %>/100</span>
                    </div>
                  </td>
                  <td style="font-size: 0.8125rem; max-width: 280px;">
                    <% st.reasons.forEach(r => { %>
                      <div>• <%= r %></div>
                    <% }) %>
                  </td>
                  <td style="font-size: 0.8125rem; color: var(--primary); font-weight: 600; max-width: 260px;">
                    <%= st.recommendedAction[0] %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>
</div>

<%- include('../partials/footer') %>

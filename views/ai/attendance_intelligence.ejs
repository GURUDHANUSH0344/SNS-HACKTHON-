<%- include('../partials/head', { pageTitle: 'Attendance Intelligence & 75% Simulator — CAMPUS AI' }) %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/navbar') %>

    <main class="content-container">
      <div class="page-header">
        <div>
          <h1 class="page-title">Attendance Intelligence & 75% Target Simulator</h1>
          <p class="page-subtitle">Algorithmic Attendance Projection Ensuring 100% Exam Eligibility Compliance</p>
        </div>
      </div>

      <!-- Current Regulatory Standing Card -->
      <div class="card" style="margin-bottom: 1.5rem; border-left: 4px solid <%= statusType === 'healthy' ? 'var(--success)' : statusType === 'warning' ? 'var(--warning)' : 'var(--danger)' %>;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
          <div>
            <span style="background: <%= statusType === 'healthy' ? 'var(--success-light)' : statusType === 'warning' ? 'var(--warning-light)' : 'var(--danger-light)' %>; color: <%= statusType === 'healthy' ? 'var(--success-dark)' : statusType === 'warning' ? 'var(--warning-dark)' : 'var(--danger-dark)' %>; padding: 4px 10px; border-radius: 999px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase;">
              REGULATORY 75% THRESHOLD MONITOR
            </span>
            <h2 style="font-size: 2rem; font-weight: 800; color: var(--text-main); margin-top: 0.5rem;">
              Current Standing: <%= currentPercentage %>%
            </h2>
            <p style="font-size: 0.95rem; color: var(--text-secondary); margin-top: 0.2rem;">
              Status: <strong><%= statusType === 'healthy' ? '✓ Safe & Eligible (>=75%)' : statusType === 'warning' ? '⚠️ Borderline Shortage (65-74%)' : '🚨 Critical Shortage (<65%)' %></strong>
            </p>
          </div>
          <div style="background: var(--primary-light); border: 1px solid var(--border); padding: 1.25rem 1.75rem; border-radius: var(--radius-md); text-align: center; color: var(--primary);">
            <div style="font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">Classes Required For 75%</div>
            <div style="font-size: 2.5rem; font-weight: 800; line-height: 1; margin: 0.25rem 0;"><%= classesRequired %></div>
            <div style="font-size: 0.75rem; color: var(--text-secondary);">Consecutive Lectures</div>
          </div>
        </div>
      </div>

      <!-- Metrics Breakdown -->
      <div class="grid-cards">
        <div class="card stat-card">
          <div class="stat-info">
            <span>Total Conducted</span>
            <h2><%= totalClasses %></h2>
            <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">Lectures & Practical Labs</p>
          </div>
          <div class="stat-icon blue">📚</div>
        </div>

        <div class="card stat-card">
          <div class="stat-info">
            <span>Attended Lectures</span>
            <h2 style="color: var(--success);"><%= attendedClasses %></h2>
            <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">Present / Late Marks</p>
          </div>
          <div class="stat-icon green">✅</div>
        </div>

        <div class="card stat-card">
          <div class="stat-info">
            <span>Missed Lectures</span>
            <h2 style="color: var(--danger);"><%= totalClasses - attendedClasses %></h2>
            <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">Unexcused Absences</p>
          </div>
          <div class="stat-icon red">❌</div>
        </div>

        <div class="card stat-card">
          <div class="stat-info">
            <span>Bunk Margin Safe</span>
            <h2 style="color: var(--primary);"><%= canBunk %></h2>
            <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">Can skip & remain &gt;=75%</p>
          </div>
          <div class="stat-icon purple">🛡️</div>
        </div>
      </div>

      <!-- Interactive 75% Future Scenario Simulator -->
      <div class="card" style="margin-bottom: 1.5rem; border-top: 3px solid var(--primary);">
        <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--primary);">
          🎛️ Interactive Attendance Target Simulator
        </h3>
        <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1.5rem;">
          Simulate how attending or missing future lectures affects your semester eligibility.
        </p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
          <div>
            <div class="form-group">
              <label class="form-label" style="display: flex; justify-content: space-between;">
                <span>Future Lectures You Will Attend:</span>
                <strong id="simFutureAttendVal" style="color: var(--primary);">5</strong>
              </label>
              <input type="range" id="simFutureAttend" min="0" max="30" value="5" oninput="updateSim()" style="width: 100%;" />
            </div>

            <div class="form-group">
              <label class="form-label" style="display: flex; justify-content: space-between;">
                <span>Future Lectures You Plan To Skip:</span>
                <strong id="simFutureMissVal" style="color: var(--danger);">0</strong>
              </label>
              <input type="range" id="simFutureMiss" min="0" max="15" value="0" oninput="updateSim()" style="width: 100%;" />
            </div>
          </div>

          <div style="background: #f8fafc; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1.5rem; display: flex; flex-direction: column; justify-content: center; text-align: center;">
            <span style="font-size: 0.8125rem; color: var(--text-muted); text-transform: uppercase;">Simulated Projected Attendance</span>
            <div id="simProjectedPct" style="font-size: 2.75rem; font-weight: 800; color: var(--primary); margin: 0.35rem 0;">
              <%= currentPercentage %>%
            </div>
            <div id="simVerdict" style="font-size: 0.95rem; font-weight: 700; color: <%= currentPercentage >= 75 ? 'var(--success)' : 'var(--danger)' %>;">
              <%= currentPercentage >= 75 ? '✓ Exam Eligible' : '⚠️ Shortage Risk' %>
            </div>
          </div>
        </div>
      </div>

    </main>
  </div>
</div>

<script>
  const baseAttended = <%= attendedClasses %>;
  const baseTotal = <%= totalClasses %>;

  function updateSim() {
    const futureAttend = parseInt(document.getElementById('simFutureAttend').value);
    const futureMiss = parseInt(document.getElementById('simFutureMiss').value);

    document.getElementById('simFutureAttendVal').textContent = futureAttend;
    document.getElementById('simFutureMissVal').textContent = futureMiss;

    const newAttended = baseAttended + futureAttend;
    const newTotal = baseTotal + futureAttend + futureMiss;
    const newPct = newTotal > 0 ? Math.round((newAttended / newTotal) * 100) : 0;

    const pctEl = document.getElementById('simProjectedPct');
    const verdictEl = document.getElementById('simVerdict');

    pctEl.textContent = `${newPct}%`;
    if (newPct >= 75) {
      pctEl.style.color = 'var(--success)';
      verdictEl.textContent = '✓ Exam Eligible (>=75%)';
      verdictEl.style.color = 'var(--success)';
    } else {
      pctEl.style.color = 'var(--danger)';
      verdictEl.textContent = '⚠️ Shortage Warning (<75%)';
      verdictEl.style.color = 'var(--danger)';
    }
  }

  document.addEventListener('DOMContentLoaded', updateSim);
</script>

<%- include('../partials/footer') %>

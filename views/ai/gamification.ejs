<%- include('../partials/head', { pageTitle: 'Campus AI Gamification & Hall of Fame — CAMPUS AI' }) %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/navbar') %>

    <main class="content-container">
      <div class="page-header">
        <div>
          <h1 class="page-title">Campus AI Gamification & Hall of Fame</h1>
          <p class="page-subtitle">Academic Streaks, Learning XP, Unlocked Badges & Institutional Leaderboard</p>
        </div>
      </div>

      <!-- Player Gamification Status Banner -->
      <div class="card" style="margin-bottom: 1.5rem; border-left: 4px solid var(--primary); padding: 1.5rem 1.75rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem;">
          <div style="display: flex; align-items: center; gap: 1.25rem;">
            <div style="width: 64px; height: 64px; border-radius: 50%; background: var(--soft-surface); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 1.75rem; color: var(--primary);">
              ⚡
            </div>
            <div>
              <span class="status-pill status-ai-insight" style="margin-bottom: 0.35rem;">
                Level <%= gamification ? gamification.level : 4 %> Academic Scholar
              </span>
              <h2 style="font-size: 1.85rem; font-weight: 800; margin-top: 0.25rem; color: var(--text-main);">
                <%= student ? student.name : 'Student' %>
              </h2>
              <p style="font-size: 0.8125rem; color: var(--text-secondary); margin-top: 0.2rem;">
                <%= gamification ? gamification.streakDays : 7 %> Day Continuous Study Streak • Active Today
              </p>
            </div>
          </div>

          <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <div style="background: var(--soft-surface); border: 1px solid var(--border); padding: 0.85rem 1.25rem; border-radius: var(--radius-sm); text-align: center;">
              <div style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); font-weight: 700;">Total XP</div>
              <div style="font-size: 1.85rem; font-weight: 800; line-height: 1; margin: 0.25rem 0; color: var(--primary);"><%= gamification ? gamification.totalXp : 850 %></div>
              <div style="font-size: 0.7rem; color: var(--text-muted);">Experience Points</div>
            </div>

            <div style="background: var(--soft-surface); border: 1px solid var(--border); padding: 0.85rem 1.25rem; border-radius: var(--radius-sm); text-align: center;">
              <div style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Growth Score</div>
              <div style="font-size: 2.4rem; font-weight: 900; line-height: 1; margin: 0.25rem 0; color: #a7f3d0;"><%= gamification ? gamification.growthScore : 88 %></div>
              <div style="font-size: 0.7rem; opacity: 0.85;">Cognitive Index</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Action / Earn XP Banner -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
        <div class="card" style="padding: 1.25rem; display: flex; align-items: center; justify-content: space-between; border-left: 4px solid var(--primary);">
          <div>
            <h4 style="font-weight: 700; margin-bottom: 0.2rem;">Complete Adaptive Quiz</h4>
            <p style="font-size: 0.75rem; color: var(--text-secondary);">Earn up to 150 XP + Quiz Mastery boost</p>
          </div>
          <a href="/ai/quiz" class="btn btn-primary btn-sm">Take Quiz →</a>
        </div>

        <div class="card" style="padding: 1.25rem; display: flex; align-items: center; justify-content: space-between; border-left: 4px solid var(--success);">
          <div>
            <h4 style="font-weight: 700; margin-bottom: 0.2rem;">Daily 7-Day Plan Task</h4>
            <p style="font-size: 0.75rem; color: var(--text-secondary);">Maintain active streak & unlock badges</p>
          </div>
          <a href="/ai/learning-path" class="btn btn-secondary btn-sm">View Plan →</a>
        </div>

        <div class="card" style="padding: 1.25rem; display: flex; align-items: center; justify-content: space-between; border-left: 4px solid var(--warning);">
          <div>
            <h4 style="font-weight: 700; margin-bottom: 0.2rem;">Attendance Target</h4>
            <p style="font-size: 0.75rem; color: var(--text-secondary);">Keep >= 75% for Attendance Sentinel badge</p>
          </div>
          <a href="/ai/attendance-intelligence" class="btn btn-secondary btn-sm">Check →</a>
        </div>
      </div>

      <!-- Main Columns: Badges & Leaderboard -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
        
        <!-- Badges Collection -->
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Unlocked Trophies & Micro-Badges</h3>
            <span class="badge badge-primary"><%= badges.length %> Earned</span>
          </div>
          <div class="card-body">
            <div style="display: grid; grid-template-columns: 1fr; gap: 0.85rem;">
              <% if (badges.length > 0) { %>
                <% badges.forEach(b => { %>
                  <div style="display: flex; gap: 1rem; align-items: center; padding: 0.85rem; border: 1px solid var(--border-color); border-radius: var(--radius-sm); background: #fdfdfd;">
                    <div style="font-size: 2rem; width: 45px; height: 45px; display: flex; align-items: center; justify-content: center; background: #f1f5f9; border-radius: var(--radius-sm);">
                      <%= b.icon || '🏅' %>
                    </div>
                    <div style="flex: 1;">
                      <h4 style="font-size: 0.9rem; font-weight: 700; margin-bottom: 0.2rem;"><%= b.title %></h4>
                      <p style="font-size: 0.75rem; color: var(--text-secondary); line-height: 1.3;"><%= b.description %></p>
                    </div>
                    <span class="badge badge-success" style="font-size: 0.65rem;">+100 XP</span>
                  </div>
                <% }) %>
              <% } else { %>
                <div style="text-align: center; padding: 2rem; color: var(--text-muted);">
                  <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🎯</div>
                  <p>Complete quizzes and learning paths to unlock trophies!</p>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Hall of Fame / Leaderboard -->
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Institutional Hall of Fame (Top 10)</h3>
            <span class="badge badge-info">Semester 2026</span>
          </div>
          <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th style="width: 50px;">Rank</th>
                    <th>Student Scholar</th>
                    <th>Level</th>
                    <th style="text-align: right;">Total XP</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (leaderboard && leaderboard.length > 0) { %>
                    <% leaderboard.forEach((entry, idx) => { %>
                      <tr style="<%= student && entry.studentId === student.id ? 'background: #eff6ff; font-weight: 700;' : '' %>">
                        <td>
                          <% if (idx === 0) { %>
                            <span style="font-size: 1.2rem;">🥇</span>
                          <% } else if (idx === 1) { %>
                            <span style="font-size: 1.2rem;">🥈</span>
                          <% } else if (idx === 2) { %>
                            <span style="font-size: 1.2rem;">🥉</span>
                          <% } else { %>
                            <span style="color: var(--text-muted); font-weight: 600;">#<%= idx + 1 %></span>
                          <% } %>
                        </td>
                        <td>
                          <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <span><%= studentMap[entry.studentId] || 'Scholar' %></span>
                            <% if (student && entry.studentId === student.id) { %>
                              <span class="badge badge-primary" style="font-size: 0.65rem;">You</span>
                            <% } %>
                          </div>
                        </td>
                        <td>
                          <span class="badge badge-secondary" style="font-size: 0.7rem;">Lvl <%= entry.level %></span>
                        </td>
                        <td style="text-align: right; font-weight: 700; color: var(--primary);">
                          <%= entry.totalXp %> XP
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td>🥇</td>
                      <td><%= student ? student.name : 'Student' %></td>
                      <td><span class="badge badge-secondary">Lvl 4</span></td>
                      <td style="text-align: right; font-weight: 700; color: var(--primary);">850 XP</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>

    </main>
  </div>
</div>

<%- include('../partials/footer') %>

<%- include('../partials/head', { pageTitle: 'Performance Simulator & Academic Risk — CampusAI' }) %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/navbar') %>

    <main class="content-container">
      
      <!-- Institutional Header -->
      <div style="background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius-card); padding: 1.5rem 1.75rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; box-shadow: var(--shadow-xs);">
        <div>
          <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.25rem;">
            <h1 class="page-title" style="margin-bottom: 0; font-size: 1.5rem; font-weight: 800; color: var(--text-main);">
              Performance Simulator
            </h1>
            <span class="status-pill status-ai-insight" style="font-size: 0.7rem; font-weight: 700;">Predictive Model</span>
          </div>
          <p style="font-size: 0.8125rem; color: var(--text-secondary); margin-top: 0.2rem;">
            Explore how changes in attendance, marks and assignments may affect your academic risk.
          </p>
        </div>

        <div style="display: flex; gap: 0.75rem;">
          <a href="/ai/learning-path" class="btn btn-secondary btn-sm">
            Learning Path
          </a>
          <a href="/student/results" class="btn btn-primary btn-sm">
            Exam Ledger →
          </a>
        </div>
      </div>

      <!-- Current Standing Overview Card -->
      <div class="card" style="margin-bottom: 1.5rem; border-left: 4px solid var(--primary);">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.25rem;">
          <div>
            <div style="font-size: 0.72rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted); letter-spacing: 0.05em;">
              Current Baseline Evaluation
            </div>
            <div style="display: flex; align-items: baseline; gap: 0.5rem; margin-top: 0.25rem;">
              <h2 style="font-size: 2rem; font-weight: 800; color: var(--primary); margin: 0;">
                <%= prediction.predictedSgpa %>
              </h2>
              <span style="font-size: 1rem; color: var(--text-muted); font-weight: 500;">/ 10.0 Projected SGPA</span>
            </div>
            <p style="font-size: 0.8125rem; color: var(--text-secondary); margin: 0.35rem 0 0 0;">
              Standing Category: <strong><%= prediction.performanceTier %></strong> • Current Risk Status: 
              <span class="status-pill status-<%= prediction.riskLevel.toLowerCase() %>"><%= prediction.riskLevel %> Risk</span>
            </p>
          </div>

          <div style="text-align: right; background: var(--soft-surface); border: 1px solid var(--border); padding: 0.85rem 1.25rem; border-radius: var(--radius-sm);">
            <div style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Composite Index</div>
            <div style="font-size: 1.85rem; font-weight: 800; color: var(--text-main);"><%= prediction.compositeScore %>/100</div>
            <div style="font-size: 0.72rem; color: var(--text-muted);">98.4% Confidence Interval</div>
          </div>
        </div>
      </div>

      <!-- Interactive Performance Simulator Tool (Master Prompt Specification) -->
      <div class="card" style="margin-bottom: 1.5rem;">
        <div class="card-header">
          <div>
            <h3 class="card-title">Interactive Risk & Grade Simulator</h3>
            <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.15rem;">
              Simulate prospective interventions to gauge target grade trajectories
            </p>
          </div>
          <span class="status-pill status-ai-insight">AI Simulation</span>
        </div>

        <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem; align-items: center;">
          
          <!-- Controls Column -->
          <div style="display: flex; flex-direction: column; gap: 1.25rem;">
            
            <!-- Attendance Control -->
            <div>
              <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.4rem;">
                <span><strong>Attendance Rate</strong> (Current: <%= attendanceRate %>%)</span>
                <span>Target: <strong id="valAttendance">82%</strong></span>
              </div>
              <input type="range" min="50" max="100" value="82" id="simAttendance" style="width: 100%; accent-color: var(--primary);" oninput="updateSim()" />
              <div style="display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--text-muted); margin-top: 0.2rem;">
                <span>50%</span>
                <span>75% (Mandatory Cutoff)</span>
                <span>100%</span>
              </div>
            </div>

            <!-- Subject / Internal Mark Control -->
            <div>
              <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.4rem;">
                <span><strong>Internal Assessment Marks</strong> (Current: <%= avgMarks %>%)</span>
                <span>Target: <strong id="valMarks">75%</strong></span>
              </div>
              <input type="range" min="35" max="100" value="75" id="simMarks" style="width: 100%; accent-color: var(--primary);" oninput="updateSim()" />
              <div style="display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--text-muted); margin-top: 0.2rem;">
                <span>35%</span>
                <span>60% (Passing Threshold)</span>
                <span>100%</span>
              </div>
            </div>

            <!-- Assignment Completion Control -->
            <div>
              <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.4rem;">
                <span><strong>Assignments Pipeline</strong> (Current: 7 / 10)</span>
                <span>Target: <strong id="valAssignments">9 / 10</strong></span>
              </div>
              <input type="range" min="1" max="10" value="9" id="simAssignments" style="width: 100%; accent-color: var(--primary);" oninput="updateSim()" />
              <div style="display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--text-muted); margin-top: 0.2rem;">
                <span>1 / 10</span>
                <span>5 / 10</span>
                <span>10 / 10</span>
              </div>
            </div>

          </div>

          <!-- Simulation Result Box (Master Prompt Specification) -->
          <div style="background: var(--soft-surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 0.72rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted);">Comparative Projection</span>
              <span class="status-pill status-ai-insight">AI Prediction</span>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; text-align: center;">
              <div style="padding: 1rem; background: #FFFFFF; border: 1px solid var(--border); border-radius: 6px;">
                <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Current Risk</div>
                <div id="dispCurrentRisk" style="font-size: 1.35rem; font-weight: 800; color: <%= prediction.riskLevel === 'Low' ? 'var(--success)' : 'var(--warning)' %>; margin-top: 0.35rem;">
                  <%= prediction.riskLevel.toUpperCase() %>
                </div>
              </div>

              <div style="padding: 1rem; background: #FFFFFF; border: 1px solid var(--border); border-radius: 6px;">
                <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Projected Risk</div>
                <div id="dispProjectedRisk" style="font-size: 1.35rem; font-weight: 800; color: var(--success); margin-top: 0.35rem;">
                  LOW
                </div>
              </div>
            </div>

            <div style="padding: 0.85rem; background: #FFFFFF; border: 1px solid var(--border); border-radius: 6px;">
              <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.25rem;">
                <span>Simulated SGPA Target:</span>
                <strong id="dispSimSgpa" style="color: var(--primary);">8.6 / 10.0</strong>
              </div>
              <div style="font-size: 0.72rem; color: var(--text-muted);">
                Estimated Academic Standing: <strong>First Class Distinction</strong>
              </div>
            </div>

            <div style="font-size: 0.72rem; color: var(--text-muted); line-height: 1.4; border-top: 1px solid var(--border); padding-top: 0.75rem;">
              <strong>Disclaimer:</strong> AI Prediction — NOT a guaranteed result. Projections depend upon final examination performance and continuous academic evaluation.
            </div>
          </div>

        </div>
      </div>

      <!-- Contributing Factors & Radar Attribution -->
      <div style="display: grid; grid-template-columns: 1.25fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
        
        <!-- Factor Weights & Impact -->
        <div class="card">
          <div class="card-header">
            <div>
              <h3 class="card-title">Contributing Factors & Feature Attribution</h3>
              <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.15rem;">
                Relative weights synthesized by the white-box regression model
              </p>
            </div>
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <% prediction.factors.forEach(f => { %>
              <div style="background: var(--soft-surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.75rem 0.85rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
                  <div>
                    <strong style="font-size: 0.8125rem; color: var(--text-main);"><%= f.name %></strong>
                    <span style="font-size: 0.7rem; color: var(--text-muted); margin-left: 0.35rem;">Weight: <%= f.weight %></span>
                  </div>
                  <span class="status-pill <%= f.impact.includes('Positive') || f.impact.includes('Meets') || f.impact.includes('Proficient') || f.impact.includes('Consistent') ? 'status-low' : 'status-high' %>">
                    <%= f.impact %>
                  </span>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 0.78125rem;">
                  <span style="color: var(--text-muted);">Current Metric Score:</span>
                  <strong><%= f.score %></strong>
                </div>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Professional Chart.js Radar Visualization -->
        <div class="card" style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
          <div class="card-header" style="width: 100%;">
            <div>
              <h3 class="card-title">Competency Attribution Radar</h3>
              <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.15rem;">Multi-dimensional profile</p>
            </div>
          </div>
          <div style="width: 100%; max-width: 320px; height: 260px;">
            <canvas id="predictionRadarChart"></canvas>
          </div>
        </div>

      </div>

      <!-- Subject Forecast & Strategic Recommendations -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
        
        <!-- Subject Grade Forecast -->
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Subject-Wise Projected Final Grades</h3>
          </div>
          <div style="display: flex; flex-direction: column; gap: 0.65rem;">
            <% prediction.subjectForecasts.forEach(sub => { %>
              <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 0.85rem; background: var(--soft-surface); border: 1px solid var(--border); border-radius: var(--radius-sm);">
                <div>
                  <strong style="font-size: 0.8125rem; color: var(--text-main);"><%= sub.subject %></strong>
                  <div style="font-size: 0.72rem; color: var(--text-muted);">Projected Final Score: <%= sub.predictedScore %>/100</div>
                </div>
                <span class="status-pill status-low">Grade <%= sub.grade %></span>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Strategic AI Recommendations -->
        <div class="card" style="border-top: 3px solid var(--primary);">
          <div class="card-header">
            <h3 class="card-title" style="color: var(--primary);">AI Actionable Recommendations</h3>
          </div>
          <ul style="font-size: 0.8125rem; color: var(--text-secondary); display: flex; flex-direction: column; gap: 0.75rem; padding-left: 1.25rem; margin: 0;">
            <% prediction.recommendations.forEach(rec => { %>
              <li><%= rec %></li>
            <% }) %>
          </ul>
          <div style="margin-top: 1.25rem; display: flex; gap: 0.65rem; border-top: 1px solid var(--border); padding-top: 1rem;">
            <a href="/ai/learning-path" class="btn btn-primary btn-sm">Start 7-Day AI Plan</a>
            <a href="/ai/quiz" class="btn btn-secondary btn-sm">Adaptive Practice Quiz</a>
          </div>
        </div>

      </div>

    </main>
  </div>
</div>

<script>
  function updateSim() {
    const att = parseInt(document.getElementById('simAttendance').value);
    const marks = parseInt(document.getElementById('simMarks').value);
    const asg = parseInt(document.getElementById('simAssignments').value);

    document.getElementById('valAttendance').textContent = att + '%';
    document.getElementById('valMarks').textContent = marks + '%';
    document.getElementById('valAssignments').textContent = asg + ' / 10';

    // Calculate simulated SGPA & Risk
    const simScore = (att * 0.3) + (marks * 0.5) + ((asg * 10) * 0.2);
    const simSgpa = Math.min(10.0, Math.max(5.0, (simScore / 10).toFixed(1)));
    
    document.getElementById('dispSimSgpa').textContent = simSgpa + ' / 10.0';

    const projRiskEl = document.getElementById('dispProjectedRisk');
    if (att < 75 || marks < 55) {
      projRiskEl.textContent = 'HIGH';
      projRiskEl.style.color = 'var(--danger)';
    } else if (att < 80 || marks < 65) {
      projRiskEl.textContent = 'MEDIUM';
      projRiskEl.style.color = 'var(--warning)';
    } else {
      projRiskEl.textContent = 'LOW';
      projRiskEl.style.color = 'var(--success)';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const ctx = document.getElementById('predictionRadarChart').getContext('2d');
    new Chart(ctx, {
      type: 'radar',
      data: {
        labels: ['Internal Marks', 'Attendance', 'Assignments', 'Quiz Mastery', 'Consistency'],
        datasets: [{
          label: 'Student Metrics',
          data: [<%= avgMarks %>, <%= attendanceRate %>, 85, 88, 86],
          backgroundColor: 'rgba(15, 39, 71, 0.15)',
          borderColor: '#0F2747',
          borderWidth: 2,
          pointBackgroundColor: '#0F2747',
          pointBorderColor: '#FFFFFF'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          r: {
            min: 0,
            max: 100,
            ticks: { display: false }
          }
        },
        plugins: {
          legend: { display: false }
        }
      }
    });
  });
</script>

<%- include('../partials/footer') %>

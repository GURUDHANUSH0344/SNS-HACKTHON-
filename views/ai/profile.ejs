<%- include('../partials/head', { pageTitle: '360° Student Digital Profile & Growth Score — CAMPUS AI' }) %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/navbar') %>

    <main class="content-container">
      <div class="page-header">
        <div>
          <h1 class="page-title">360° Student Digital Profile</h1>
          <p class="page-subtitle">Algorithmic Competency Index, Growth Score & Verified Achievements</p>
        </div>
        <div class="header-actions">
          <a href="/student/export" class="btn btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Export Comprehensive Portfolio (PDF)
          </a>
        </div>
      </div>

      <!-- Growth Score Hero Card -->
      <div class="card" style="margin-bottom: 1.5rem; border-left: 4px solid var(--primary); padding: 1.5rem 1.75rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem;">
          <div style="display: flex; align-items: center; gap: 1.25rem;">
            <div style="width: 64px; height: 64px; border-radius: 50%; background: var(--soft-surface); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 1.85rem; font-weight: 800; color: var(--primary);">
              <%= student ? student.name.charAt(0) : 'S' %>
            </div>
            <div>
              <span class="status-pill status-ai-insight" style="margin-bottom: 0.35rem;">
                Student Growth Index
              </span>
              <h2 style="font-size: 1.85rem; font-weight: 800; margin-top: 0.25rem; color: var(--text-main);">
                <%= student ? student.name : 'Candidate' %>
              </h2>
              <p style="font-size: 0.8125rem; color: var(--text-secondary); margin-top: 0.2rem;">
                <%= student ? student.course : 'Computer Science & Engineering' %> • Year <%= student ? student.year : '3' %> • ID: <code class="font-mono"><%= student ? student.studentId : 'STU-2026-001' %></code>
              </p>
            </div>
          </div>

          <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <div style="background: var(--soft-surface); border: 1px solid var(--border); padding: 1rem 1.5rem; border-radius: var(--radius-sm); text-align: center;">
              <div style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); font-weight: 700;">Composite Growth Score</div>
              <div style="font-size: 2.2rem; font-weight: 900; line-height: 1; margin: 0.25rem 0; color: var(--primary);"><%= gamification ? gamification.growthScore : 88 %></div>
              <div style="font-size: 0.75rem; color: var(--success); font-weight: 600;">Top 5% Cohort Tier</div>
            </div>

            <div style="background: rgba(255,255,255,0.18); backdrop-filter: blur(10px); padding: 1.25rem 1.5rem; border-radius: var(--radius-md); text-align: center; border: 1px solid rgba(255,255,255,0.25);">
              <div style="font-size: 0.75rem; text-transform: uppercase;">Level & Tier</div>
              <div style="font-size: 2rem; font-weight: 800; margin: 0.25rem 0;">Level <%= gamification ? gamification.level : 4 %></div>
              <div style="font-size: 0.75rem; opacity: 0.9;"><%= gamification ? gamification.totalXp : 850 %> XP Earned</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Growth Dimension Breakdown & Radar Visualizer -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
        
        <!-- Competency Dimensions -->
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Core Growth Dimensions</h3>
            <span class="badge badge-info">Weighted Algorithmic Index</span>
          </div>
          <div class="card-body">
            
            <div style="margin-bottom: 1.25rem;">
              <div style="display: flex; justify-content: space-between; font-weight: 600; margin-bottom: 0.4rem;">
                <span style="display: flex; align-items: center; gap: 0.5rem;">
                  <span style="color: var(--primary);">📘</span> Academic Consistency
                </span>
                <span><%= gamification ? gamification.academicConsistency : 88 %>%</span>
              </div>
              <div style="height: 10px; background: var(--bg-main); border-radius: 999px; overflow: hidden;">
                <div style="height: 100%; width: <%= gamification ? gamification.academicConsistency : 88 %>%; background: var(--primary); border-radius: 999px;"></div>
              </div>
              <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Calculated across semester internal assessments, exams, and credit progression.</p>
            </div>

            <div style="margin-bottom: 1.25rem;">
              <div style="display: flex; justify-content: space-between; font-weight: 600; margin-bottom: 0.4rem;">
                <span style="display: flex; align-items: center; gap: 0.5rem;">
                  <span style="color: var(--warning);">⚡</span> Quiz Mastery
                </span>
                <span><%= gamification ? gamification.quizMastery : 84 %>%</span>
              </div>
              <div style="height: 10px; background: var(--bg-main); border-radius: 999px; overflow: hidden;">
                <div style="height: 100%; width: <%= gamification ? gamification.quizMastery : 84 %>%; background: var(--warning); border-radius: 999px;"></div>
              </div>
              <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Demonstrated in AI adaptive MCQ quizzes, algorithmic speed, and retakes.</p>
            </div>

            <div style="margin-bottom: 1.25rem;">
              <div style="display: flex; justify-content: space-between; font-weight: 600; margin-bottom: 0.4rem;">
                <span style="display: flex; align-items: center; gap: 0.5rem;">
                  <span style="color: var(--success);">🛡️</span> Attendance Discipline
                </span>
                <span><%= gamification ? gamification.attendanceDiscipline : 82 %>%</span>
              </div>
              <div style="height: 10px; background: var(--bg-main); border-radius: 999px; overflow: hidden;">
                <div style="height: 100%; width: <%= gamification ? gamification.attendanceDiscipline : 82 %>%; background: var(--success); border-radius: 999px;"></div>
              </div>
              <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Conducted classroom lectures, practical lab hours, and minimal bunk rate.</p>
            </div>

            <div>
              <div style="display: flex; justify-content: space-between; font-weight: 600; margin-bottom: 0.4rem;">
                <span style="display: flex; align-items: center; gap: 0.5rem;">
                  <span style="color: var(--info);">🎯</span> Career Readiness
                </span>
                <span><%= gamification ? gamification.careerReadiness : 79 %>%</span>
              </div>
              <div style="height: 10px; background: var(--bg-main); border-radius: 999px; overflow: hidden;">
                <div style="height: 100%; width: <%= gamification ? gamification.careerReadiness : 79 %>%; background: var(--info); border-radius: 999px;"></div>
              </div>
              <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Industry skill alignment, project completion, and milestone certifications.</p>
            </div>

          </div>
        </div>

        <!-- Competency Radar & AI Evaluation Summary -->
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Cognitive Competency Matrix</h3>
            <span class="badge badge-success">Verified Real-Time</span>
          </div>
          <div class="card-body" style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
            
            <div style="position: relative; width: 220px; height: 220px; margin: 1rem 0;">
              <!-- Visual Radar SVG Representation -->
              <svg viewBox="0 0 200 200" style="width: 100%; height: 100%;">
                <polygon points="100,20 180,75 160,165 40,165 20,75" fill="none" stroke="#e2e8f0" stroke-width="1.5" />
                <polygon points="100,50 150,85 135,145 65,145 50,85" fill="none" stroke="#cbd5e1" stroke-width="1" />
                <polygon points="100,80 120,95 115,125 85,125 80,95" fill="none" stroke="#94a3b8" stroke-width="1" />
                <polygon points="100,32 165,80 148,155 55,152 35,82" fill="rgba(37, 99, 235, 0.25)" stroke="#2563eb" stroke-width="2.5" />
                <circle cx="100" cy="32" r="4" fill="#2563eb" />
                <circle cx="165" cy="80" r="4" fill="#2563eb" />
                <circle cx="148" cy="155" r="4" fill="#2563eb" />
                <circle cx="55" cy="152" r="4" fill="#2563eb" />
                <circle cx="35" cy="82" r="4" fill="#2563eb" />
              </svg>
            </div>

            <div style="width: 100%; background: #f8fafc; border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 1rem; margin-top: 0.5rem;">
              <h4 style="font-size: 0.85rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.35rem;">CAMPUS AI Growth Evaluation</h4>
              <p style="font-size: 0.8rem; color: var(--text-secondary); line-height: 1.5;">
                Candidate exhibits exceptional algorithmic resilience and rigorous attendance compliance. Strategic focus recommended on Cloud Deployment and Industry Capstone projects to accelerate Career Readiness score past 85.
              </p>
            </div>

          </div>
        </div>

      </div>

      <!-- Achievement Badges & Milestones -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Institutional Badges & Verified Micro-Credentials</h3>
          <span class="badge badge-primary"><%= badges.length %> Badges Unlocked</span>
        </div>
        <div class="card-body">
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem;">
            <% if (badges.length > 0) { %>
              <% badges.forEach(b => { %>
                <div style="display: flex; gap: 1rem; align-items: center; padding: 1rem; border: 1px solid var(--border-color); border-radius: var(--radius-md); background: #ffffff; transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
                  <div style="width: 50px; height: 50px; border-radius: var(--radius-sm); background: #eff6ff; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; flex-shrink: 0;">
                    <%= b.icon || '🏅' %>
                  </div>
                  <div>
                    <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.2rem;"><%= b.title %></h4>
                    <p style="font-size: 0.75rem; color: var(--text-secondary); line-height: 1.4;"><%= b.description %></p>
                    <span style="display: inline-block; font-size: 0.7rem; color: var(--text-muted); margin-top: 0.25rem;">Earned: <%= b.earnedAt || 'Recently' %></span>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div style="display: flex; gap: 1rem; align-items: center; padding: 1rem; border: 1px solid var(--border-color); border-radius: var(--radius-md); background: #ffffff;">
                <div style="width: 50px; height: 50px; border-radius: var(--radius-sm); background: #eff6ff; display: flex; align-items: center; justify-content: center; font-size: 1.8rem;">
                  🏆
                </div>
                <div>
                  <h4 style="font-size: 0.95rem; font-weight: 700;">Algorithmic Prodigy</h4>
                  <p style="font-size: 0.75rem; color: var(--text-secondary);">Scored 100% on Data Structures & Trees</p>
                  <span style="font-size: 0.7rem; color: var(--text-muted);">Verified Credential</span>
                </div>
              </div>
              <div style="display: flex; gap: 1rem; align-items: center; padding: 1rem; border: 1px solid var(--border-color); border-radius: var(--radius-md); background: #ffffff;">
                <div style="width: 50px; height: 50px; border-radius: var(--radius-sm); background: #ecfdf5; display: flex; align-items: center; justify-content: center; font-size: 1.8rem;">
                  🛡️
                </div>
                <div>
                  <h4 style="font-size: 0.95rem; font-weight: 700;">Attendance Guardian</h4>
                  <p style="font-size: 0.75rem; color: var(--text-secondary);">Maintained 80%+ streak across 4 consecutive weeks</p>
                  <span style="font-size: 0.7rem; color: var(--text-muted);">Verified Credential</span>
                </div>
              </div>
              <div style="display: flex; gap: 1rem; align-items: center; padding: 1rem; border: 1px solid var(--border-color); border-radius: var(--radius-md); background: #ffffff;">
                <div style="width: 50px; height: 50px; border-radius: var(--radius-sm); background: #fdf2f8; display: flex; align-items: center; justify-content: center; font-size: 1.8rem;">
                  🚀
                </div>
                <div>
                  <h4 style="font-size: 0.95rem; font-weight: 700;">Continuous Learner</h4>
                  <p style="font-size: 0.75rem; color: var(--text-secondary);">Completed 7-Day AI Learning Path with distinction</p>
                  <span style="font-size: 0.7rem; color: var(--text-muted);">Verified Credential</span>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      </div>

    </main>
  </div>
</div>

<%- include('../partials/footer') %>

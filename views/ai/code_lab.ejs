<script>
  window.__INITIAL_SESSION_ID = '<%= activeSession ? activeSession.id : "" %>';
  window.__STARTER_TEMPLATES = <%- JSON.stringify(starterTemplates) %>;

  async function deleteSession(id) {
    if (!confirm('Are you sure you want to delete this saved session?')) return;
    try {
      const res = await fetch('/api/code-lab/sessions/' + id, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert(data.error || 'Failed to delete session');
      }
    } catch (e) {
      alert('Network error: ' + e.message);
    }
  }
</script>


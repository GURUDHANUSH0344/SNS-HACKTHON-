<%- include('../partials/head', { pageTitle: 'Institutional AI Analytics & Trends — CAMPUS AI' }) %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/navbar') %>

    <main class="content-container">
      <div class="page-header">
        <div>
          <h1 class="page-title">Institutional AI Analytics & Trends</h1>
          <p class="page-subtitle">Multi-Dimensional Campus Intelligence: Attendance Heatmaps, Risk Indices & Operations</p>
        </div>
        <div class="header-actions">
          <a href="/ai/reports" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            Generate AI Institutional Report (PDF)
          </a>
        </div>
      </div>

      <!-- Macro Metric Cards -->
      <div class="grid-cards" style="margin-bottom: 2rem;">
        <div class="card stat-card">
          <div class="stat-info">
            <span>Enrolled Students</span>
            <h2><%= totalStudents || 240 %></h2>
            <p style="font-size: 0.75rem; color: var(--success); margin-top: 0.2rem;">+12% vs last academic year</p>
          </div>
          <div class="stat-icon" style="background: #eff6ff; color: var(--primary);">👥</div>
        </div>

        <div class="card stat-card">
          <div class="stat-info">
            <span>Campus-Wide Attendance</span>
            <h2><%= avgAttendance || 83 %>%</h2>
            <p style="font-size: 0.75rem; color: var(--success); margin-top: 0.2rem;">8% Above Regulatory Minimum</p>
          </div>
          <div class="stat-icon" style="background: #ecfdf5; color: var(--success);">📊</div>
        </div>

        <div class="card stat-card">
          <div class="stat-info">
            <span>Campus Issue Tickets</span>
            <h2><%= totalProblems || 18 %></h2>
            <p style="font-size: 0.75rem; color: var(--info); margin-top: 0.2rem;"><%= resolvedProblems || 14 %> Tickets Resolved</p>
          </div>
          <div class="stat-icon" style="background: #e0f2fe; color: var(--info);">🛠️</div>
        </div>

        <div class="card stat-card">
          <div class="stat-info">
            <span>Institutional AI Health</span>
            <h2 style="color: var(--primary);">94.8 / 100</h2>
            <p style="font-size: 0.75rem; color: var(--success); margin-top: 0.2rem;">Optimal Accreditation Grade</p>
          </div>
          <div class="stat-icon" style="background: #fdf2f8; color: #db2777;">⭐</div>
        </div>
      </div>

      <!-- Charts & Visual Analytics Section -->
      <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
        
        <!-- Attendance & Academic Progression Trend -->
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Semester Progression & Cohort Attendance Rate</h3>
            <span class="badge badge-primary">Real-Time Aggregates</span>
          </div>
          <div class="card-body">
            <!-- SVG Trend Graph -->
            <div style="width: 100%; height: 240px; position: relative;">
              <svg viewBox="0 0 500 200" style="width: 100%; height: 100%;">
                <line x1="40" y1="20" x2="480" y2="20" stroke="#f1f5f9" stroke-width="1" />
                <line x1="40" y1="65" x2="480" y2="65" stroke="#f1f5f9" stroke-width="1" />
                <line x1="40" y1="110" x2="480" y2="110" stroke="#f1f5f9" stroke-width="1" />
                <line x1="40" y1="155" x2="480" y2="155" stroke="#e2e8f0" stroke-width="1.5" />
                
                <!-- 75% Regulatory Threshold Line -->
                <line x1="40" y1="75" x2="480" y2="75" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="4,4" />
                <text x="485" y="79" fill="#ef4444" font-size="10" font-weight="bold">75% Target</text>

                <!-- Attendance Curve -->
                <polyline 
                  fill="none" 
                  stroke="#2563eb" 
                  stroke-width="3" 
                  points="50,60 120,50 190,45 260,70 330,40 400,35 470,30" 
                />

                <!-- Marks Curve -->
                <polyline 
                  fill="none" 
                  stroke="#10b981" 
                  stroke-width="3" 
                  points="50,90 120,80 190,75 260,65 330,55 400,50 470,45" 
                />

                <circle cx="50" cy="60" r="4" fill="#2563eb" />
                <circle cx="120" cy="50" r="4" fill="#2563eb" />
                <circle cx="190" cy="45" r="4" fill="#2563eb" />
                <circle cx="260" cy="70" r="4" fill="#2563eb" />
                <circle cx="330" cy="40" r="4" fill="#2563eb" />
                <circle cx="400" cy="35" r="4" fill="#2563eb" />
                <circle cx="470" cy="30" r="4" fill="#2563eb" />

                <!-- X-Axis Labels -->
                <text x="45" y="175" fill="#64748b" font-size="10">W1</text>
                <text x="115" y="175" fill="#64748b" font-size="10">W3</text>
                <text x="185" y="175" fill="#64748b" font-size="10">W6</text>
                <text x="255" y="175" fill="#64748b" font-size="10">W9</text>
                <text x="325" y="175" fill="#64748b" font-size="10">W12</text>
                <text x="395" y="175" fill="#64748b" font-size="10">W15</text>
                <text x="465" y="175" fill="#64748b" font-size="10">W18</text>
              </svg>
            </div>

            <div style="display: flex; justify-content: center; gap: 2rem; margin-top: 1rem; font-size: 0.8rem;">
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span style="width: 12px; height: 12px; background: #2563eb; border-radius: 2px;"></span>
                <span>Cohort Attendance (%)</span>
              </div>
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span style="width: 12px; height: 12px; background: #10b981; border-radius: 2px;"></span>
                <span>Average Academic Performance (%)</span>
              </div>
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span style="width: 12px; height: 2px; background: #ef4444; border-radius: 2px;"></span>
                <span>Regulatory Threshold (75%)</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Department Resolution & SLA Compliance -->
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Department SLA Radar</h3>
            <span class="badge badge-success">92% Compliance</span>
          </div>
          <div class="card-body">
            <div style="margin-bottom: 1.25rem;">
              <div style="display: flex; justify-content: space-between; font-size: 0.82rem; margin-bottom: 0.35rem;">
                <span>IT & Network Center</span>
                <strong>98% on-time</strong>
              </div>
              <div style="height: 8px; background: #f1f5f9; border-radius: 999px;">
                <div style="height: 100%; width: 98%; background: var(--success); border-radius: 999px;"></div>
              </div>
            </div>

            <div style="margin-bottom: 1.25rem;">
              <div style="display: flex; justify-content: space-between; font-size: 0.82rem; margin-bottom: 0.35rem;">
                <span>Electrical & Power</span>
                <strong>94% on-time</strong>
              </div>
              <div style="height: 8px; background: #f1f5f9; border-radius: 999px;">
                <div style="height: 100%; width: 94%; background: var(--primary); border-radius: 999px;"></div>
              </div>
            </div>

            <div style="margin-bottom: 1.25rem;">
              <div style="display: flex; justify-content: space-between; font-size: 0.82rem; margin-bottom: 0.35rem;">
                <span>Civil & Infrastructure</span>
                <strong>89% on-time</strong>
              </div>
              <div style="height: 8px; background: #f1f5f9; border-radius: 999px;">
                <div style="height: 100%; width: 89%; background: var(--warning); border-radius: 999px;"></div>
              </div>
            </div>

            <div style="margin-bottom: 1.25rem;">
              <div style="display: flex; justify-content: space-between; font-size: 0.82rem; margin-bottom: 0.35rem;">
                <span>Hostel & Facilities</span>
                <strong>91% on-time</strong>
              </div>
              <div style="height: 8px; background: #f1f5f9; border-radius: 999px;">
                <div style="height: 100%; width: 91%; background: var(--info); border-radius: 999px;"></div>
              </div>
            </div>

            <div>
              <div style="display: flex; justify-content: space-between; font-size: 0.82rem; margin-bottom: 0.35rem;">
                <span>Laboratory Equipment</span>
                <strong>96% on-time</strong>
              </div>
              <div style="height: 8px; background: #f1f5f9; border-radius: 999px;">
                <div style="height: 100%; width: 96%; background: var(--success); border-radius: 999px;"></div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Institutional Risk Distribution & Hotspot Heatmap -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Early Warning Risk Distribution</h3>
            <span class="badge badge-info">Explainable AI</span>
          </div>
          <div class="card-body">
            <div style="display: flex; gap: 1rem; align-items: center; justify-content: space-around; padding: 1.5rem 0;">
              <div style="text-align: center;">
                <div style="font-size: 2.2rem; font-weight: 800; color: var(--success);">78%</div>
                <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase;">Low Risk / Thriving</div>
              </div>
              <div style="text-align: center;">
                <div style="font-size: 2.2rem; font-weight: 800; color: var(--warning);">15%</div>
                <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase;">Moderate Concern</div>
              </div>
              <div style="text-align: center;">
                <div style="font-size: 2.2rem; font-weight: 800; color: var(--danger);">7%</div>
                <div style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase;">High / Critical Intervention</div>
              </div>
            </div>
            <div style="border-top: 1px solid var(--border-color); padding-top: 1rem;">
              <a href="/ai/early-warning" class="btn btn-secondary btn-sm" style="width: 100%; justify-content: center;">
                Open Institutional Early Warning Triage Matrix →
              </a>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Campus Infrastructure Hotspots</h3>
            <span class="badge badge-warning">AI Problem Routing</span>
          </div>
          <div class="card-body">
            <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1rem;">
              Most frequent incident clusters identified by ticket classification algorithms:
            </p>
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
              <div style="display: flex; justify-content: space-between; padding: 0.5rem 0.75rem; background: #f8fafc; border-radius: var(--radius-sm); font-size: 0.85rem;">
                <span>Main Academic Block - 3rd Floor Lab 302</span>
                <span class="badge badge-danger">4 Network Tickets</span>
              </div>
              <div style="display: flex; justify-content: space-between; padding: 0.5rem 0.75rem; background: #f8fafc; border-radius: var(--radius-sm); font-size: 0.85rem;">
                <span>Boys Hostel Block B - Wing 2</span>
                <span class="badge badge-warning">2 Electrical Tickets</span>
              </div>
              <div style="display: flex; justify-content: space-between; padding: 0.5rem 0.75rem; background: #f8fafc; border-radius: var(--radius-sm); font-size: 0.85rem;">
                <span>Mechanical Engineering Workshop</span>
                <span class="badge badge-info">1 Tool Calibration</span>
              </div>
            </div>
            <div style="border-top: 1px solid var(--border-color); padding-top: 1rem; margin-top: 1rem;">
              <a href="/problems/analytics" class="btn btn-secondary btn-sm" style="width: 100%; justify-content: center;">
                View Deep Problem Analytics & GIS Maps →
              </a>
            </div>
          </div>
        </div>
      </div>

    </main>
  </div>
</div>

<%- include('../partials/footer') %>

<%- include('../../partials/head', { pageTitle: 'Smart Resource Optimization — CAMPUS AI' }) %>

<div class="app-layout">
  <%- include('../../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../../partials/navbar') %>

    <main class="content-container resource-page-container">
      <!-- 1. Header Banner -->
      <div class="page-header" style="margin-bottom: 1.5rem;">
        <div>
          <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.35rem;">
            <span class="badge" style="background: #0F2747; color: #FFFFFF; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em;">CAMPUSAI INTELLIGENCE</span>
            <span class="badge" style="background: #EFF6FF; color: #1D4ED8; border: 1px solid #BFDBFE; font-size: 0.72rem; font-weight: 700;">DEMO READY</span>
          </div>
          <h1 class="page-title" style="font-size: 1.65rem; color: #0F2747; font-weight: 800; letter-spacing: -0.02em;">Smart Resource Optimization</h1>
          <p class="page-subtitle" style="font-size: 0.875rem; color: #475569; margin: 0;">
            Understand. Predict. Solve. Improve. — <em>"Use Every Campus Resource Smarter."</em>
          </p>
        </div>
        <div class="page-header-actions" style="display: flex; gap: 0.65rem; flex-wrap: wrap;">
          <button type="button" class="btn btn-secondary btn-sm" onclick="openRequestModal()">
            <span>➕ Smart Allocation</span>
          </button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="switchResourceTab('simulator')">
            <span>🧪 What-If Simulator</span>
          </button>
          <button type="button" class="btn btn-primary btn-sm" onclick="triggerJudgeDemoFlow()" style="background: #0F2747; border-color: #0F2747; box-shadow: 0 2px 4px rgba(15,39,71,0.2);">
            <span>🔥 Live Judge Demo</span>
          </button>
        </div>
      </div>

      <!-- 2. Intelligence Pipeline Indicator -->
      <div class="card" style="margin-bottom: 1.25rem; padding: 0.85rem 1.25rem; background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 10px;">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
          <span style="font-size: 0.75rem; font-weight: 800; color: #0F2747; text-transform: uppercase; letter-spacing: 0.05em;">Intelligence Pipeline:</span>
          <div class="pipeline-track" style="display: flex; align-items: center; gap: 0.4rem; overflow-x: auto; font-size: 0.72rem; font-weight: 700;">
            <span class="pipeline-step">COLLECT</span>
            <span class="pipeline-arrow">→</span>
            <span class="pipeline-step">UNDERSTAND</span>
            <span class="pipeline-arrow">→</span>
            <span class="pipeline-step">MEASURE UTILIZATION</span>
            <span class="pipeline-arrow">→</span>
            <span class="pipeline-step active">DETECT BOTTLENECKS</span>
            <span class="pipeline-arrow">→</span>
            <span class="pipeline-step">PREDICT DEMAND</span>
            <span class="pipeline-arrow">→</span>
            <span class="pipeline-step active">RECOMMEND ACTION</span>
            <span class="pipeline-arrow">→</span>
            <span class="pipeline-step">ADMIN APPROVAL</span>
            <span class="pipeline-arrow">→</span>
            <span class="pipeline-step">TRACK AUDIT</span>
          </div>
        </div>
      </div>

      <!-- 3. Top Master KPIs Grid -->
      <div class="resource-kpi-grid">
        <!-- 1. Overall Utilization -->
        <div class="resource-kpi-card">
          <div class="resource-kpi-top">
            <span class="resource-kpi-label">Overall Utilization</span>
            <div class="resource-kpi-icon kpi-icon-success" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
              </svg>
            </div>
          </div>
          <div class="resource-kpi-metric kpi-metric-success" id="kpiOptimalUtil">74%</div>
          <div class="resource-kpi-desc">12 units in healthy utilization range</div>
        </div>

        <!-- 2. Underutilized -->
        <div class="resource-kpi-card">
          <div class="resource-kpi-top">
            <span class="resource-kpi-label">Underutilized</span>
            <div class="resource-kpi-icon kpi-icon-warning" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/>
                <polyline points="17 18 23 18 23 12"/>
              </svg>
            </div>
          </div>
          <div class="resource-kpi-metric kpi-metric-warning" id="kpiUnderutilizedCount"><%= efficiencyData.counts.underutilized %></div>
          <div class="resource-kpi-desc">Idle capacity detected</div>
        </div>

        <!-- 3. Overloaded -->
        <div class="resource-kpi-card">
          <div class="resource-kpi-top">
            <span class="resource-kpi-label">Overloaded</span>
            <div class="resource-kpi-icon kpi-icon-danger" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
              </svg>
            </div>
          </div>
          <div class="resource-kpi-metric kpi-metric-danger" id="kpiOverloadedCount"><%= efficiencyData.counts.overloaded %></div>
          <div class="resource-kpi-desc">Lab 1 & Seminar Hall require attention</div>
        </div>

        <!-- 4. Campus Efficiency -->
        <div class="resource-kpi-card">
          <div class="resource-kpi-top">
            <span class="resource-kpi-label">Campus Efficiency</span>
            <div class="resource-kpi-icon kpi-icon-navy" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 14 4-4"/>
                <path d="M3.34 19a10 10 0 1 1 17.32 0"/>
              </svg>
            </div>
          </div>
          <div class="resource-kpi-metric kpi-metric-navy" id="kpiEfficiencyScore">76 <span class="metric-unit">/ 100</span></div>
          <div class="resource-kpi-desc" id="kpiEfficiencySub">Baseline efficiency score</div>
        </div>
      </div>

      <!-- 4. 🔥 LIVE JUDGE DEMO SHOWCASE BANNER -->
      <div class="card" id="judgeDemoBanner" style="background: #FFFFFF; border: 2px solid #BFDBFE; border-radius: 12px; padding: 1.35rem; margin-bottom: 1.5rem; box-shadow: 0 4px 6px -1px rgba(15,39,71,0.08);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
          <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
              <span class="badge" style="background: #1D4ED8; color: #FFFFFF; font-weight: 700; font-size: 0.7rem;">JUDGE LIVE DEMONSTRATION</span>
              <span class="badge" style="background: #DCFCE7; color: #15803D; font-weight: 700; font-size: 0.7rem;">INSTITUTIONAL DECISION SUPPORT</span>
            </div>
            <h3 style="font-size: 1.15rem; font-weight: 800; color: #0F2747; margin: 0;">
              Autonomous Opportunity Detected: Computer Lab 1 Overload ↔ Computer Lab 3 Underutilization
            </h3>
            <p style="font-size: 0.8125rem; color: #475569; margin: 0.3rem 0 0 0;">
              CampusAI detected <strong>Class CS402 (Python Practical, 55 Students, 2 PM–4 PM)</strong> scheduled in overloaded Lab 1 while identical Lab 3 remains 69% idle.
            </p>
          </div>

          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <button type="button" class="btn btn-secondary btn-sm" id="btnDemoSimulate" onclick="runJudgeDemoSimulation()">
              <span>🧪 Simulate Allocation</span>
            </button>
            <button type="button" class="btn btn-secondary btn-sm" id="btnDemoWhy" onclick="toggleDemoExplainability()">
              <span>💡 Why Lab 3? (92%)</span>
            </button>
            <button type="button" class="btn btn-primary btn-sm" id="btnDemoApprove" onclick="approveJudgeDemoAllocation()" style="background: #0F2747; border-color: #0F2747;">
              <span>✓ Approve Allocation</span>
            </button>
          </div>
        </div>

        <!-- Before vs After Demonstration Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; padding: 1rem;">
          <!-- Lab 1 Status Card -->
          <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 8px; padding: 0.85rem 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <span style="font-weight: 700; font-size: 0.875rem; color: #0F2747;">Computer Lab 1 (Block B, Fl 2)</span>
              <span class="badge" id="demoLab1Badge" style="background: #FEE2E2; color: #B91C1C; font-weight: 700; font-size: 0.68rem;">OVERLOADED</span>
            </div>
            <div style="display: flex; align-items: baseline; gap: 0.75rem;">
              <span style="font-size: 1.35rem; font-weight: 800;" id="demoLab1Value">94%</span>
              <span style="font-size: 0.75rem; color: #64748B;">Time Utilization</span>
              <span id="demoLab1Delta" style="font-size: 0.75rem; font-weight: 700; display: none;"></span>
            </div>
            <div class="metric-progress-track" style="height: 6px; background: #E2E8F0; border-radius: 99px; margin-top: 0.5rem; overflow: hidden;">
              <div id="demoLab1Bar" style="width: 94%; height: 100%; background: #DC2626; transition: all 0.5s ease;"></div>
            </div>
            <span style="font-size: 0.72rem; color: #64748B; display: block; margin-top: 0.4rem;" id="demoLab1Note">Peak congestion: 10:00–13:00 & 14:00–16:00</span>
          </div>

          <!-- Lab 3 Status Card -->
          <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 8px; padding: 0.85rem 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <span style="font-weight: 700; font-size: 0.875rem; color: #0F2747;">Computer Lab 3 (Block B, Fl 2)</span>
              <span class="badge" id="demoLab3Badge" style="background: #FEF3C7; color: #B45309; font-weight: 700; font-size: 0.68rem;">UNDERUTILIZED</span>
            </div>
            <div style="display: flex; align-items: baseline; gap: 0.75rem;">
              <span style="font-size: 1.35rem; font-weight: 800;" id="demoLab3Value">31%</span>
              <span style="font-size: 0.75rem; color: #64748B;">Time Utilization</span>
              <span id="demoLab3Delta" style="font-size: 0.75rem; font-weight: 700; display: none;"></span>
            </div>
            <div class="metric-progress-track" style="height: 6px; background: #E2E8F0; border-radius: 99px; margin-top: 0.5rem; overflow: hidden;">
              <div id="demoLab3Bar" style="width: 31%; height: 100%; background: #D97706; transition: all 0.5s ease;"></div>
            </div>
            <span style="font-size: 0.72rem; color: #64748B; display: block; margin-top: 0.4rem;" id="demoLab3Note">Idle Unused Window: 14:00–16:00 (27.6 hrs/wk idle)</span>
          </div>

          <!-- Campus Efficiency Impact -->
          <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 8px; padding: 0.85rem 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <span style="font-weight: 700; font-size: 0.875rem; color: #0F2747;">Campus Efficiency Index</span>
              <span class="badge" id="demoEffBadge" style="background: #EFF6FF; color: #1D4ED8; font-weight: 700; font-size: 0.68rem;">HEALTH SCORE</span>
            </div>
            <div style="display: flex; align-items: baseline; gap: 0.75rem;">
              <span style="font-size: 1.35rem; font-weight: 800; color: #0F2747;" id="demoEffValue">76 / 100</span>
              <span id="demoEffDelta" style="font-size: 0.75rem; font-weight: 700; color: #15803D; display: none;">+8 Points Lift</span>
            </div>
            <div class="metric-progress-track" style="height: 6px; background: #E2E8F0; border-radius: 99px; margin-top: 0.5rem; overflow: hidden;">
              <div id="demoEffBar" style="width: 76%; height: 100%; background: #0F2747; transition: all 0.5s ease;"></div>
            </div>
            <span style="font-size: 0.72rem; color: #64748B; display: block; margin-top: 0.4rem;" id="demoEffNote">Space (84) • Equipment (78) • Schedule (87)</span>
          </div>
        </div>

        <!-- Explainability Accordion ("Why Lab 3?") -->
        <div id="demoExplainabilityBox" style="display: none; margin-top: 1rem; background: #F1F5F9; border: 1px solid #CBD5E1; border-radius: 8px; padding: 1rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.6rem;">
            <span style="font-weight: 800; font-size: 0.875rem; color: #0F2747;">CampusAI Cognitive Decision Breakdown: Why Computer Lab 3?</span>
            <span class="badge" style="background: #DCFCE7; color: #15803D; font-weight: 800;">CONFIDENCE: 92%</span>
          </div>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.65rem; font-size: 0.78rem;">
            <div style="background: #FFFFFF; padding: 0.6rem 0.75rem; border-radius: 6px; border: 1px solid #E2E8F0;">
              <strong>✓ Availability (+30 pts):</strong> 100% free on Wednesday 14:00–16:00
            </div>
            <div style="background: #FFFFFF; padding: 0.6rem 0.75rem; border-radius: 6px; border: 1px solid #E2E8F0;">
              <strong>✓ Capacity (+25 pts):</strong> 60 workstations fits 55 students with zero waste
            </div>
            <div style="background: #FFFFFF; padding: 0.6rem 0.75rem; border-radius: 6px; border: 1px solid #E2E8F0;">
              <strong>✓ Balance (+15 pts):</strong> Recovers unused 31% capacity from idle lab
            </div>
            <div style="background: #FFFFFF; padding: 0.6rem 0.75rem; border-radius: 6px; border: 1px solid #E2E8F0;">
              <strong>✓ Equipment (+15 pts):</strong> Gigabit LAN & Python 3.12 stack verified
            </div>
            <div style="background: #FFFFFF; padding: 0.6rem 0.75rem; border-radius: 6px; border: 1px solid #E2E8F0;">
              <strong>✓ Co-location (+15 pts):</strong> Same department & Floor 2 Block B corridor
            </div>
          </div>
        </div>
      </div>

      <!-- 5. Navigation Tab Pills -->
      <div style="display: flex; gap: 0.5rem; overflow-x: auto; margin-bottom: 1.25rem; border-bottom: 1px solid #E2E8F0; padding-bottom: 0.5rem;">
        <button type="button" class="tab-btn active" id="tab-btn-recommendations" onclick="switchResourceTab('recommendations')">
          <span>💡 AI Recommendations</span>
          <span class="badge badge-primary" style="font-size: 0.65rem;"><%= recommendations.length %></span>
        </button>
        <button type="button" class="tab-btn" id="tab-btn-inventory" onclick="switchResourceTab('inventory')">
          <span>🏛️ Master Inventory (<%= resources.length %>)</span>
        </button>
        <button type="button" class="tab-btn" id="tab-btn-heatmap" onclick="switchResourceTab('heatmap')">
          <span>📊 Utilization Heatmap</span>
        </button>
        <button type="button" class="tab-btn" id="tab-btn-demand" onclick="switchResourceTab('demand')">
          <span>🔮 Demand Prediction</span>
        </button>
        <button type="button" class="tab-btn" id="tab-btn-map" onclick="switchResourceTab('map')">
          <span>🗺️ Campus Building Map</span>
        </button>
        <button type="button" class="tab-btn" id="tab-btn-simulator" onclick="switchResourceTab('simulator')">
          <span>🧪 What-If Simulator</span>
        </button>
        <button type="button" class="tab-btn" id="tab-btn-audit" onclick="switchResourceTab('audit')">
          <span>📜 Audit Log (<%= auditLogs.length %>)</span>
        </button>
      </div>

      <!-- TAB 1: AI RECOMMENDATIONS -->
      <div id="tab-content-recommendations" class="resource-tab-content active">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <div>
            <h3 style="font-size: 1.05rem; font-weight: 700; color: #0F2747; margin: 0;">Prescriptive Resource Recommendations</h3>
            <span style="font-size: 0.78rem; color: #64748B;">Automated algorithmic suggestions with full mathematical explainability</span>
          </div>
          <span class="badge" style="background: #EFF6FF; color: #1D4ED8; font-weight: 700;">HUMAN-IN-THE-LOOP APPROVAL REQUIRED</span>
        </div>

        <div style="display: flex; flex-direction: column; gap: 1rem;">
          <% recommendations.forEach((rec, idx) => { %>
            <div class="card" style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 10px; padding: 1.25rem;">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
                <div style="display: flex; align-items: center; gap: 0.6rem;">
                  <span style="width: 28px; height: 28px; border-radius: 6px; background: #0F2747; color: #FFF; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.8rem;">
                    <%= idx + 1 %>
                  </span>
                  <div>
                    <h4 style="font-size: 0.95rem; font-weight: 800; color: #0F2747; margin: 0;"><%= rec.title %></h4>
                    <span style="font-size: 0.75rem; color: #64748B;">Target Resource: <strong><%= rec.resource ? rec.resource.name : 'Computer Lab' %></strong></span>
                  </div>
                </div>

                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  <span class="badge" style="background: #DCFCE7; color: #15803D; font-weight: 700; font-size: 0.72rem;">
                    <%= rec.confidence %>% Confidence
                  </span>
                  <span class="badge" style="background: #F1F5F9; color: #475569; font-weight: 600; font-size: 0.72rem; text-transform: uppercase;">
                    <%= rec.recommendationType %>
                  </span>
                </div>
              </div>

              <!-- Recommendation Details Grid -->
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0.75rem; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 6px; padding: 0.85rem; font-size: 0.8125rem; margin-bottom: 0.85rem;">
                <div>
                  <span style="font-weight: 700; color: #B91C1C; display: block; margin-bottom: 0.2rem;">⚠️ Problem Detected:</span>
                  <span style="color: #334155;"><%= rec.problem %></span>
                </div>
                <div>
                  <span style="font-weight: 700; color: #0F2747; display: block; margin-bottom: 0.2rem;">📊 Empirical Evidence:</span>
                  <span style="color: #334155;"><%= rec.evidence %></span>
                </div>
                <div>
                  <span style="font-weight: 700; color: #15803D; display: block; margin-bottom: 0.2rem;">⚡ Expected Impact:</span>
                  <span style="color: #334155;"><%= rec.impact %></span>
                </div>
              </div>

              <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
                <span style="font-size: 0.8125rem; color: #1D4ED8; font-weight: 700;">
                  📈 Expected: <%= rec.expectedImprovement || 'Optimal Load Rebalancing' %>
                </span>
                <div style="display: flex; gap: 0.5rem;">
                  <button type="button" class="btn btn-secondary btn-sm" onclick="runJudgeDemoSimulation()">
                    <span>🧪 Simulate</span>
                  </button>
                  <button type="button" class="btn btn-primary btn-sm" onclick="approveDirectRecommendation(<%= rec.id %>)" style="background: #0F2747; border-color: #0F2747;">
                    <span>Approve Allocation</span>
                  </button>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- TAB 2: MASTER INVENTORY -->
      <div id="tab-content-inventory" class="resource-tab-content" style="display: none;">
        <!-- Filter Toolbar -->
        <div class="card" style="margin-bottom: 1rem; padding: 1rem; background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 8px;">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
            <div style="display: flex; align-items: center; gap: 0.5rem; flex: 1; min-width: 260px;">
              <input type="text" id="inventorySearchInput" class="form-control" placeholder="Search by resource name, code, building, department..." oninput="filterInventoryTable()" style="height: 38px; font-size: 0.85rem;" />
            </div>
            <div style="display: flex; gap: 0.65rem; flex-wrap: wrap;">
              <select id="filterCategory" class="form-control" onchange="filterInventoryTable()" style="width: auto; height: 38px; font-size: 0.84rem; font-weight: 600;">
                <option value="all">All Categories</option>
                <option value="Academic Space">Academic Spaces</option>
                <option value="Equipment">Equipment</option>
                <option value="People">People (Staff/Assistants)</option>
                <option value="Facilities">Facilities</option>
              </select>

              <select id="filterStatus" class="form-control" onchange="filterInventoryTable()" style="width: auto; height: 38px; font-size: 0.84rem; font-weight: 600;">
                <option value="all">All Utilization Statuses</option>
                <option value="UNDERUTILIZED">Underutilized (≤30%)</option>
                <option value="OPTIMALLY UTILIZED">Optimally Utilized (31–70%)</option>
                <option value="HIGH UTILIZATION">High Utilization (71–90%)</option>
                <option value="OVERLOADED">Overloaded (≥91%)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Inventory Data Table -->
        <div class="table-container">
          <div class="table-header-tools">
            <div>
              <span style="font-weight: 700; font-size: 0.95rem; color: #0F2747;">Institutional Resource Master (<span id="inventoryCount"><%= resources.length %></span>)</span>
              <span style="font-size: 0.75rem; color: #64748B; display: block;">Tracked physical spaces, smart equipment, lab staff, and student facilities</span>
            </div>
          </div>
          <div class="table-responsive">
            <table class="data-table" id="inventoryTable">
              <thead>
                <tr>
                  <th>RESOURCE</th>
                  <th>TYPE & CATEGORY</th>
                  <th>LOCATION</th>
                  <th>CAPACITY</th>
                  <th>TIME UTILIZATION</th>
                  <th>CAPACITY UTIL</th>
                  <th>STATUS</th>
                  <th>ACTION</th>
                </tr>
              </thead>
              <tbody id="inventoryTableBody">
                <% resources.forEach(r => { %>
                  <tr class="inventory-row" data-name="<%= r.name.toLowerCase() %>" data-code="<%= r.code.toLowerCase() %>" data-category="<%= r.category %>" data-status="<%= r.utilizationStatus %>" data-building="<%= r.building.toLowerCase() %>">
                    <td>
                      <div>
                        <strong style="color: #0F2747; font-size: 0.85rem;"><%= r.name %></strong>
                        <span style="display: block; font-size: 0.72rem; color: #64748B; font-family: monospace;"><%= r.code %></span>
                      </div>
                    </td>
                    <td>
                      <span style="font-weight: 600; font-size: 0.78rem; color: #334155;"><%= r.type %></span>
                      <span class="badge" style="background: #F1F5F9; color: #475569; font-size: 0.65rem; display: block; width: fit-content; margin-top: 0.2rem;"><%= r.category %></span>
                    </td>
                    <td>
                      <span style="font-size: 0.8125rem; color: #334155;"><%= r.building %></span>
                      <span style="display: block; font-size: 0.72rem; color: #64748B;">Floor <%= r.floor %></span>
                    </td>
                    <td>
                      <strong><%= r.capacity %></strong> <span style="font-size: 0.75rem; color: #64748B;"><%= r.category === 'Equipment' ? 'Unit' : (r.category === 'People' ? 'Assigned' : 'Seats') %></span>
                    </td>
                    <td>
                      <div style="min-width: 90px;">
                        <div style="display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: 700; margin-bottom: 0.2rem;">
                          <span><%= r.timeUtilization %>%</span>
                          <span style="font-size: 0.68rem; color: #64748B;"><%= r.weeklyUsedHours %>h / <%= r.weeklyAvailableHours %>h</span>
                        </div>
                        <div class="score-progress-bar" style="height: 4px; background: #E2E8F0; border-radius: 99px; overflow: hidden;">
                          <div style="width: <%= Math.min(100, r.timeUtilization) %>%; height: 100%; background: <%= r.timeUtilization >= 90 ? '#DC2626' : (r.timeUtilization >= 70 ? '#2563EB' : (r.timeUtilization >= 30 ? '#15803D' : '#D97706')) %>;"></div>
                        </div>
                      </div>
                    </td>
                    <td>
                      <span style="font-weight: 700; font-size: 0.8125rem; color: #334155;"><%= r.capacityUtilization %>%</span>
                      <span style="display: block; font-size: 0.7rem; color: #64748B;">Avg: <%= r.averageOccupancy %> occ</span>
                    </td>
                    <td>
                      <% 
                        let sClass = 'background: #DCFCE7; color: #15803D; border: 1px solid #BBF7D0;';
                        if (r.utilizationStatus === 'OVERLOADED') sClass = 'background: #FEE2E2; color: #B91C1C; border: 1px solid #FECACA;';
                        else if (r.utilizationStatus === 'UNDERUTILIZED') sClass = 'background: #FEF3C7; color: #B45309; border: 1px solid #FDE68A;';
                        else if (r.utilizationStatus === 'HIGH UTILIZATION') sClass = 'background: #EFF6FF; color: #1D4ED8; border: 1px solid #BFDBFE;';
                      %>
                      <span class="badge" style="<%= sClass %> font-size: 0.68rem; font-weight: 800;">
                        <%= r.utilizationStatus %>
                      </span>
                    </td>
                    <td>
                      <a href="/ai/resources/detail/<%= r.code %>" class="btn btn-secondary btn-sm" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;">
                        View Profile
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- TAB 3: UTILIZATION HEATMAP -->
      <div id="tab-content-heatmap" class="resource-tab-content" style="display: none;">
        <div class="card" style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 10px; padding: 1.25rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem;">
            <div>
              <h3 style="font-size: 1.05rem; font-weight: 800; color: #0F2747; margin: 0;">Time-Slot Utilization Heatmap</h3>
              <span style="font-size: 0.78rem; color: #64748B;">Color intensity indicates load density across academic day intervals</span>
            </div>
            <!-- Heatmap legend -->
            <div style="display: flex; align-items: center; gap: 0.85rem; font-size: 0.72rem; font-weight: 600;">
              <span style="display: flex; align-items: center; gap: 0.35rem;"><span style="width: 14px; height: 14px; background: #EFF6FF; border: 1px solid #DBEAFE; border-radius: 3px;"></span> Idle (0–30%)</span>
              <span style="display: flex; align-items: center; gap: 0.35rem;"><span style="width: 14px; height: 14px; background: #BFDBFE; border-radius: 3px;"></span> Optimal (31–70%)</span>
              <span style="display: flex; align-items: center; gap: 0.35rem;"><span style="width: 14px; height: 14px; background: #60A5FA; border-radius: 3px;"></span> High (71–90%)</span>
              <span style="display: flex; align-items: center; gap: 0.35rem;"><span style="width: 14px; height: 14px; background: #1D4ED8; color: #fff; border-radius: 3px;"></span> Overloaded (≥91%)</span>
            </div>
          </div>

          <div class="table-responsive">
            <table class="data-table" style="text-align: center;">
              <thead>
                <tr>
                  <th style="text-align: left;">RESOURCE</th>
                  <th>08:00–10:00</th>
                  <th>10:00–12:00</th>
                  <th>12:00–14:00</th>
                  <th>14:00–16:00</th>
                  <th>16:00–18:00</th>
                  <th>OVERALL</th>
                </tr>
              </thead>
              <tbody>
                <% heatmapData.heatmap.forEach(row => { %>
                  <tr>
                    <td style="text-align: left;">
                      <strong style="color: #0F2747; font-size: 0.84rem;"><%= row.name %></strong>
                      <span style="display: block; font-size: 0.72rem; color: #64748B;"><%= row.code %> • <%= row.building %></span>
                    </td>
                    <% row.slots.forEach(slot => { 
                      let bg = '#EFF6FF';
                      let color = '#1E3A8A';
                      if (slot.utilization >= 90) { bg = '#1E40AF'; color = '#FFFFFF'; }
                      else if (slot.utilization >= 70) { bg = '#60A5FA'; color = '#0F172A'; }
                      else if (slot.utilization >= 30) { bg = '#BFDBFE'; color = '#1E293B'; }
                    %>
                      <td style="background: <%= bg %>; color: <%= color %>; font-weight: 700; font-size: 0.8125rem; border: 1px solid #E2E8F0;">
                        <%= slot.utilization %>%
                      </td>
                    <% }) %>
                    <td style="font-weight: 800; font-size: 0.85rem; color: #0F2747; background: #F8FAFC;">
                      <%= row.overallUtil %>%
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- TAB 4: DEMAND PREDICTION -->
      <div id="tab-content-demand" class="resource-tab-content" style="display: none;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.25rem;">
          <!-- Historical Day Patterns -->
          <div class="card" style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 10px; padding: 1.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
              <h3 style="font-size: 1rem; font-weight: 800; color: #0F2747; margin: 0;">Weekly Demand Trajectory</h3>
              <span class="badge" style="background: #F1F5F9; color: #475569; font-size: 0.68rem;">HISTORICAL TELEMETRY</span>
            </div>

            <div style="display: flex; flex-direction: column; gap: 0.85rem;">
              <% demandData.historicalDays.forEach(d => { %>
                <div>
                  <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; font-weight: 700; margin-bottom: 0.3rem;">
                    <span><%= d.day %></span>
                    <span style="color: <%= d.rate >= 90 ? '#DC2626' : (d.rate >= 80 ? '#1D4ED8' : '#334155') %>;"><%= d.rate %>% (<%= d.status %>)</span>
                  </div>
                  <div class="metric-progress-track" style="height: 8px; background: #E2E8F0; border-radius: 99px; overflow: hidden;">
                    <div style="width: <%= d.rate %>%; height: 100%; background: <%= d.rate >= 90 ? '#DC2626' : (d.rate >= 80 ? '#2563EB' : '#0F2747') %>;"></div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

          <!-- Predictive Neural Model Projection -->
          <div class="card" style="background: #FFFFFF; border: 2px solid #BFDBFE; border-radius: 10px; padding: 1.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
              <h3 style="font-size: 1rem; font-weight: 800; color: #0F2747; margin: 0;">Forecasted Bottleneck Alert</h3>
              <span class="badge" style="background: #EFF6FF; color: #1D4ED8; font-weight: 700; font-size: 0.68rem;"><%= demandData.predictionTarget.label %></span>
            </div>

            <div style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
              <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
                <span style="font-weight: 800; font-size: 1.15rem; color: #0F2747;"><%= demandData.predictionTarget.day %></span>
                <span class="badge" style="background: #FEE2E2; color: #B91C1C; font-weight: 800;">EXPECTED DEMAND: <%= demandData.predictionTarget.expectedDemand %>%</span>
              </div>
              <p style="font-size: 0.8125rem; color: #475569; margin: 0 0 0.5rem 0;">
                Available capacity buffer is projected to drop to just <strong><%= demandData.predictionTarget.expectedAvailableCapacity %>%</strong> during morning slots (<%= demandData.predictionTarget.peakWindow %>).
              </p>
              <div style="background: #FFFFFF; border-left: 3px solid #1D4ED8; padding: 0.65rem 0.85rem; font-size: 0.78rem; color: #1E293B; border-radius: 0 4px 4px 0;">
                <strong>CampusAI Proactive Guidance:</strong> <%= demandData.predictionTarget.recommendation %>
              </div>
            </div>

            <button type="button" class="btn btn-primary btn-sm" onclick="runJudgeDemoSimulation()" style="width: 100%; background: #0F2747; border-color: #0F2747;">
              Pre-emptively Balance Wednesday Practical Load →
            </button>
          </div>
        </div>
      </div>

      <!-- TAB 5: CAMPUS RESOURCE MAP -->
      <div id="tab-content-map" class="resource-tab-content" style="display: none;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.25rem;">
          <% buildingMapData.forEach(b => { %>
            <div class="card" style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 10px; padding: 1.25rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <h4 style="font-size: 1rem; font-weight: 800; color: #0F2747; margin: 0;"><%= b.building %></h4>
                <span class="badge" style="background: <%= b.resourceHealth >= 85 ? '#DCFCE7' : '#FEF3C7' %>; color: <%= b.resourceHealth >= 85 ? '#15803D' : '#B45309' %>; font-weight: 800;">
                  <%= b.resourceHealth %>% Health
                </span>
              </div>
              <p style="font-size: 0.8125rem; font-weight: 600; color: #334155; margin-bottom: 0.6rem;"><%= b.title %></p>

              <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; text-align: center; margin-bottom: 0.85rem; font-size: 0.75rem;">
                <div style="background: #F8FAFC; padding: 0.5rem; border-radius: 6px; border: 1px solid #E2E8F0;">
                  <span style="color: #64748B; display: block;">Total</span>
                  <strong style="color: #0F2747; font-size: 1rem;"><%= b.totalResources %></strong>
                </div>
                <div style="background: #FEF3C7; padding: 0.5rem; border-radius: 6px; border: 1px solid #FDE68A;">
                  <span style="color: #B45309; display: block;">Underused</span>
                  <strong style="color: #B45309; font-size: 1rem;"><%= b.underutilizedCount %></strong>
                </div>
                <div style="background: #FEE2E2; padding: 0.5rem; border-radius: 6px; border: 1px solid #FECACA;">
                  <span style="color: #B91C1C; display: block;">Overloaded</span>
                  <strong style="color: #B91C1C; font-size: 1rem;"><%= b.overloadedCount %></strong>
                </div>
              </div>

              <div style="font-size: 0.78rem; color: #475569; background: #F8FAFC; padding: 0.65rem; border-radius: 6px; margin-bottom: 0.75rem;">
                📌 <strong>Status:</strong> <%= b.highlight %>
              </div>

              <button type="button" class="btn btn-secondary btn-sm" onclick="filterByBuilding('<%= b.building %>')" style="width: 100%;">
                Filter Resources in <%= b.building %>
              </button>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- TAB 6: WHAT-IF SIMULATOR -->
      <div id="tab-content-simulator" class="resource-tab-content" style="display: none;">
        <div class="card" style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 10px; padding: 1.35rem;">
          <div style="margin-bottom: 1.25rem;">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span class="badge" style="background: #0F2747; color: #FFF; font-weight: 700;">SANDBOX ENVIRONMENT</span>
              <span class="badge" style="background: #EFF6FF; color: #1D4ED8; font-weight: 700;">NON-DESTRUCTIVE</span>
            </div>
            <h3 style="font-size: 1.15rem; font-weight: 800; color: #0F2747; margin: 0.35rem 0 0 0;">
              What-If Resource Allocation Simulator
            </h3>
            <p style="font-size: 0.8125rem; color: #64748B; margin: 0.2rem 0 0 0;">
              Test complex reallocation scenarios, hardware outages, and student surges without modifying production schedules.
            </p>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin-bottom: 1.25rem;">
            <button type="button" class="scenario-btn active" id="simScenario1" onclick="selectSimulationScenario('swap_lab1_to_lab3')">
              <span style="font-size: 1.25rem; display: block; margin-bottom: 0.35rem;">🔄</span>
              <strong>Swap CS402 (Lab 1 → Lab 3)</strong>
              <span style="font-size: 0.72rem; color: #64748B; display: block; margin-top: 0.2rem;">Rebalance 55-student practical</span>
            </button>

            <button type="button" class="scenario-btn" id="simScenario2" onclick="selectSimulationScenario('outage_lab1')">
              <span style="font-size: 1.25rem; display: block; margin-bottom: 0.35rem;">⚡</span>
              <strong>What If Lab 1 Goes Offline?</strong>
              <span style="font-size: 0.72rem; color: #64748B; display: block; margin-top: 0.2rem;">Simulate sudden hardware fault</span>
            </button>

            <button type="button" class="scenario-btn" id="simScenario3" onclick="selectSimulationScenario('surge_students')">
              <span style="font-size: 1.25rem; display: block; margin-bottom: 0.35rem;">👥</span>
              <strong>Surge: 60 Extra Students</strong>
              <span style="font-size: 0.72rem; color: #64748B; display: block; margin-top: 0.2rem;">Test lab headroom for hackathon</span>
            </button>
          </div>

          <!-- Dynamic Simulation Output Box -->
          <div id="simResultContainer" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; padding: 1.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.65rem;">
              <h4 id="simResultTitle" style="font-size: 1rem; font-weight: 800; color: #0F2747; margin: 0;">Redistribute CS402 Practical (Lab 1 → Lab 3)</h4>
              <span class="badge" style="background: #FEF3C7; color: #B45309; font-weight: 800;">SIMULATION — NOT APPLIED</span>
            </div>
            <p id="simResultSummary" style="font-size: 0.84rem; color: #475569; margin-bottom: 1rem;">
              Move CS402 Python Practical (55 students) on Wednesday 2:00 PM–4:00 PM from overloaded Computer Lab 1 to underutilized Computer Lab 3.
            </p>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem; background: #FFFFFF; padding: 1rem; border-radius: 6px; border: 1px solid #E2E8F0; margin-bottom: 1rem;">
              <div>
                <span style="font-size: 0.72rem; color: #64748B; text-transform: uppercase;">Affected Classes</span>
                <strong style="display: block; font-size: 1.1rem; color: #0F2747;" id="simAffectedClasses">1 Class (CS402)</strong>
              </div>
              <div>
                <span style="font-size: 0.72rem; color: #64748B; text-transform: uppercase;">Students Rerouted</span>
                <strong style="display: block; font-size: 1.1rem; color: #0F2747;" id="simAffectedStudents">55 Students</strong>
              </div>
              <div>
                <span style="font-size: 0.72rem; color: #64748B; text-transform: uppercase;">Campus Efficiency</span>
                <strong style="display: block; font-size: 1.1rem; color: #15803D;" id="simEfficiencyDelta">76 → 84 (+8 Lift)</strong>
              </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
              <button type="button" class="btn btn-secondary btn-sm" onclick="resetSimulator()">Reset</button>
              <button type="button" class="btn btn-primary btn-sm" onclick="approveJudgeDemoAllocation()" style="background: #0F2747; border-color: #0F2747;">
                Commit Reallocation to Production →
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 7: AUDIT LOG -->
      <div id="tab-content-audit" class="resource-tab-content" style="display: none;">
        <div class="table-container">
          <div class="table-header-tools">
            <div>
              <span style="font-weight: 700; font-size: 0.95rem; color: #0F2747;">Institutional Allocation Audit Trail</span>
              <span style="font-size: 0.75rem; color: #64748B; display: block;">Immutable log of all human-approved reallocations and baseline configurations</span>
            </div>
          </div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>TIMESTAMP</th>
                  <th>ACTION TYPE</th>
                  <th>TARGET RESOURCE</th>
                  <th>PREVIOUS</th>
                  <th>PURPOSE / REASON</th>
                  <th>APPROVED BY</th>
                </tr>
              </thead>
              <tbody id="auditLogsTableBody">
                <% auditLogs.forEach(log => { %>
                  <tr>
                    <td><span style="font-size: 0.75rem; color: #64748B;"><%= new Date(log.createdAt).toLocaleString() %></span></td>
                    <td><span class="badge" style="background: #EFF6FF; color: #1D4ED8; font-weight: 700; font-size: 0.7rem;"><%= log.actionType %></span></td>
                    <td><strong style="color: #0F2747;"><%= log.resource ? log.resource.name : 'Computer Lab 3' %></strong></td>
                    <td><span style="color: #64748B;"><%= log.previousResourceId ? 'Computer Lab 1' : 'None (Baseline)' %></span></td>
                    <td><span style="font-size: 0.78rem; color: #334155;"><%= log.reason %></span></td>
                    <td><span class="badge" style="background: #DCFCE7; color: #15803D; font-weight: 700; font-size: 0.68rem;"><%= log.approvedBy %></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </main>
  </div>
</div>

<!-- ================= MODALS ================= -->

<!-- Smart Allocation Request & Matching Modal -->
<div class="modal-overlay" id="smartAllocationModal" style="display: none;">
  <div class="modal-card" style="max-width: 580px;">
    <div class="modal-header">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <span style="font-size: 1.2rem;">⚡</span>
        <h3 class="modal-title" style="margin: 0; font-weight: 800; color: #0F2747;">Smart Resource Allocation Assistant</h3>
      </div>
      <button class="modal-close" onclick="closeRequestModal()">✕</button>
    </div>
    <div class="modal-body" style="padding: 1.25rem;">
      <p style="font-size: 0.8125rem; color: #64748B; margin-top: 0; margin-bottom: 1rem;">
        Input your class/event requirement. CampusAI evaluates capacity right-sizing, equipment compatibility, and load balance to find the <strong>optimal resource</strong>.
      </p>

      <form id="smartMatchForm" onsubmit="executeSmartMatching(event)">
        <div class="form-group" style="margin-bottom: 0.85rem;">
          <label style="font-size: 0.8125rem; font-weight: 600; color: #334155;">Session Purpose / Class:</label>
          <input type="text" id="reqPurpose" class="form-control" value="Python Practical Session" required />
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.85rem;">
          <div class="form-group">
            <label style="font-size: 0.8125rem; font-weight: 600; color: #334155;">Expected Students:</label>
            <input type="number" id="reqStudents" class="form-control" value="55" min="5" max="500" required />
          </div>
          <div class="form-group">
            <label style="font-size: 0.8125rem; font-weight: 600; color: #334155;">Department:</label>
            <select id="reqDepartment" class="form-control">
              <option value="Computer Science">Computer Science</option>
              <option value="Electronics & Communication">Electronics</option>
              <option value="Mechanical Engineering">Mechanical</option>
              <option value="Management Studies">Management</option>
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
          <div class="form-group">
            <label style="font-size: 0.8125rem; font-weight: 600; color: #334155;">Preferred Time Slot:</label>
            <select id="reqTimeSlot" class="form-control">
              <option value="14:00–16:00">2:00 PM – 4:00 PM</option>
              <option value="10:00–12:00">10:00 AM – 12:00 PM</option>
              <option value="08:30–10:30">8:30 AM – 10:30 AM</option>
            </select>
          </div>
          <div class="form-group">
            <label style="font-size: 0.8125rem; font-weight: 600; color: #334155;">Required Hardware:</label>
            <select id="reqEquipment" class="form-control">
              <option value="Workstations">60 Workstations + Projector</option>
              <option value="Smart Board">Smart Board Display</option>
              <option value="Acoustic Audio">Acoustics + Stage</option>
            </select>
          </div>
        </div>

        <!-- Recommendation Match Output (hidden until search) -->
        <div id="matchOutputBox" style="display: none; background: #F8FAFC; border: 2px solid #BFDBFE; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
            <span class="badge" style="background: #1D4ED8; color: #FFF; font-weight: 800;">BEST MATCH (Score: 100 / 100)</span>
            <strong style="color: #15803D; font-size: 0.85rem;">✓ 0 Conflicts Detected</strong>
          </div>
          <h4 style="font-size: 1.05rem; font-weight: 800; color: #0F2747; margin: 0 0 0.25rem 0;">Computer Lab 3 (Block B, Fl 2)</h4>
          <p style="font-size: 0.78rem; color: #475569; margin: 0 0 0.5rem 0;">
            Capacity 60 seats fits 55 students • 31% utilization recovers unassigned afternoon capacity • Same department corridor.
          </p>
          <div style="font-size: 0.72rem; color: #64748B;">
            Alternatives: Computer Lab 4 (Score 82), Computer Lab 2 (Insufficient Capacity - 40 seats).
          </div>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
          <button type="button" class="btn btn-secondary btn-sm" onclick="closeRequestModal()">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm" id="btnRunMatch" style="background: #0F2747; border-color: #0F2747;">
            Evaluate Best Resource →
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
/* Smart Resource Optimization - Bulletproof KPI Grid & Page Container */
.resource-page-container {
  max-width: 1440px;
  width: 100%;
  margin: 0 auto;
  padding-left: 24px;
  padding-right: 24px;
  box-sizing: border-box;
}

@media (min-width: 1440px) {
  .resource-page-container {
    padding-left: 32px;
    padding-right: 32px;
  }
}

@media (max-width: 640px) {

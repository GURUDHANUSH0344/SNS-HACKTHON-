<%- include('partials/head', { pageTitle: 'Exam & Academic Performance — CAMPUS AI' }) %>

<div class="app-layout">
  <%- include('partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('partials/navbar') %>

    <main class="content-container">
      <div class="page-header">
        <div>
          <h1 class="page-title">Examination & Marks Management</h1>
          <p class="page-subtitle">Standardized Grade Computation, Semester Transcripts, and Performance Tracking</p>
        </div>
        <div style="display: flex; gap: 0.5rem;">
          <button type="button" onclick="openModal('addExamModal')" class="btn btn-primary btn-sm">
            + Record Marks
          </button>
          <button type="button" onclick="openModal('bulkExamModal')" class="btn btn-secondary btn-sm">
            📥 Bulk Excel Import
          </button>
        </div>
      </div>

      <!-- Filters -->
      <div class="card" style="margin-bottom: 1.25rem; padding: 1rem 1.25rem;">
        <form action="/exams" method="GET" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between;">
          <div style="display: flex; gap: 1rem; flex: 1; min-width: 280px;">
            <select name="semester" class="form-control" style="max-width: 160px;" onchange="this.form.submit()">
              <option value="all" <%= selectedSemester === 'all' ? 'selected' : '' %>>All Semesters</option>
              <option value="1" <%= selectedSemester === '1' ? 'selected' : '' %>>Semester 1</option>
              <option value="2" <%= selectedSemester === '2' ? 'selected' : '' %>>Semester 2</option>
              <option value="3" <%= selectedSemester === '3' ? 'selected' : '' %>>Semester 3</option>
              <option value="4" <%= selectedSemester === '4' ? 'selected' : '' %>>Semester 4</option>
              <option value="5" <%= selectedSemester === '5' ? 'selected' : '' %>>Semester 5</option>
            </select>

            <select name="subject" class="form-control" style="max-width: 240px;" onchange="this.form.submit()">
              <option value="all" <%= selectedSubject === 'all' ? 'selected' : '' %>>All Academic Subjects</option>
              <% subjects.forEach(sub => { %>
                <option value="<%= sub.name %>" <%= selectedSubject === sub.name ? 'selected' : '' %>><%= sub.name %></option>
              <% }) %>
            </select>
          </div>
          <div style="display: flex; gap: 0.5rem;">
            <button type="submit" class="btn btn-primary btn-sm">Filter</button>
            <a href="/exams" class="btn btn-secondary btn-sm">Reset</a>
          </div>
        </form>
      </div>

      <!-- Exams Table -->
      <div class="table-container">
        <div class="table-header-tools">
          <span style="font-weight: 600; font-size: 0.875rem;">Recorded Examination Results (<%= exams.length %>)</span>
          <span style="font-size: 0.75rem; color: var(--text-muted);">Standardized 10-point scale grade mapping and AI anomaly detection</span>
        </div>

        <% if (exams && exams.length > 0) { %>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Student ID & Name</th>
                  <th>Subject</th>
                  <th>Exam Type</th>
                  <th>Sem</th>
                  <th>Marks (Obtained/Max)</th>
                  <th>Percentage</th>
                  <th>Grade</th>
                  <th>Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% exams.forEach(ex => { %>
                  <tr>
                    <td>
                      <div style="font-weight: 600;"><%= ex.student ? ex.student.name : 'Student #' + ex.studentId %></div>
                      <div style="font-size: 0.75rem; color: var(--text-muted);"><%= ex.student ? ex.student.studentId : '' %></div>
                    </td>
                    <td><strong><%= ex.subjectName %></strong></td>
                    <td><%= ex.examType %></td>
                    <td>Sem <%= ex.semester %></td>
                    <td>
                      <strong><%= ex.marksObtained %></strong> / <%= ex.maxMarks %>
                    </td>
                    <td>
                      <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-weight: 700;"><%= ex.percentage %>%</span>
                      </div>
                    </td>
                    <td>
                      <span class="status-pill status-<%= ex.grade.includes('F') ? 'critical' : ex.grade.includes('O') || ex.grade.includes('A') ? 'paid' : 'inprogress' %>">
                        <%= ex.grade %>
                      </span>
                    </td>
                    <td><%= ex.examDate || 'Recent' %></td>
                    <td>
                      <div style="display: flex; gap: 0.35rem;">
                        <button type="button" onclick="openEditExamModal('<%= ex.id %>', '<%= ex.marksObtained %>', '<%= ex.maxMarks %>', '<%= ex.examType %>', '<%= ex.remarks || '' %>')" class="btn btn-secondary btn-sm" title="Edit Marks">
                          ✏️
                        </button>
                        <form action="/exams/<%= ex.id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Delete this examination score?');">
                          <button type="submit" class="btn btn-secondary btn-sm" style="color: var(--danger);" title="Delete Record">
                            🗑️
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">
            <div class="empty-icon">📝</div>
            <div class="empty-title">No Exam Records Found</div>
            <p class="empty-text">No academic marks recorded matching the current filter.</p>
            <button onclick="openModal('addExamModal')" class="btn btn-primary btn-sm">+ Record Marks</button>
          </div>
        <% } %>
      </div>

    </main>
  </div>
</div>

<!-- Add Exam Modal -->
<div class="modal-overlay" id="addExamModal">
  <div class="modal-card">
    <div class="modal-header">
      <h3 class="modal-title">Record Examination Marks</h3>
      <button class="modal-close" data-dismiss="modal">✕</button>
    </div>
    <form action="/exams" method="POST">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Select Student</label>
          <select name="studentId" class="form-control" required>
            <% students.forEach(st => { %>
              <option value="<%= st.id %>"><%= st.name %> (<%= st.studentId %> - <%= st.course %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="form-group" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div>
            <label class="form-label">Subject</label>
            <select name="subjectName" class="form-control" required>
              <% subjects.forEach(sub => { %>
                <option value="<%= sub.name %>"><%= sub.name %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="form-label">Exam Type</label>
            <select name="examType" class="form-control" required>
              <option value="Mid Term Exam">Mid Term Exam</option>
              <option value="Model Practical Exam">Model Practical Exam</option>
              <option value="End Semester Final">End Semester Final</option>
              <option value="Continuous Internal Assessment">Continuous Internal Assessment</option>
            </select>
          </div>
        </div>
        <div class="form-group" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
          <div>
            <label class="form-label">Marks Obtained</label>
            <input type="number" step="0.5" name="marksObtained" class="form-control" placeholder="88" required />
          </div>
          <div>
            <label class="form-label">Max Marks</label>
            <input type="number" name="maxMarks" class="form-control" value="100" required />
          </div>
          <div>
            <label class="form-label">Semester</label>
            <input type="number" name="semester" class="form-control" value="5" min="1" max="8" />
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Exam Date</label>
          <input type="date" name="examDate" class="form-control" value="<%= new Date().toISOString().slice(0, 10) %>" />
        </div>
        <div class="form-group">
          <label class="form-label">Faculty Remarks</label>
          <textarea name="remarks" class="form-control" placeholder="Performance feedback, weak units, or praise..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Marks</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Exam Modal -->
<div class="modal-overlay" id="editExamModal">
  <div class="modal-card">
    <div class="modal-header">
      <h3 class="modal-title">Edit Exam Marks Record</h3>
      <button class="modal-close" data-dismiss="modal">✕</button>
    </div>
    <form id="editExamForm" method="POST">
      <div class="modal-body">
        <div class="form-group" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div>
            <label class="form-label">Marks Obtained</label>
            <input type="number" step="0.5" id="editMarksObtained" name="marksObtained" class="form-control" required />
          </div>
          <div>
            <label class="form-label">Maximum Marks</label>
            <input type="number" id="editMaxMarks" name="maxMarks" class="form-control" required />
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Exam Type</label>
          <input type="text" id="editExamType" name="examType" class="form-control" required />
        </div>
        <div class="form-group">
          <label class="form-label">Remarks</label>
          <textarea id="editExamRemarks" name="remarks" class="form-control"></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Update Marks</button>
      </div>
    </form>
  </div>
</div>

<!-- Bulk Exam Modal -->
<div class="modal-overlay" id="bulkExamModal">
  <div class="modal-card">
    <div class="modal-header">
      <h3 class="modal-title">Bulk Import Exam Scores (Excel / CSV)</h3>
      <button class="modal-close" data-dismiss="modal">✕</button>
    </div>
    <form action="/exams/bulk-upload" method="POST" enctype="multipart/form-data">
      <div class="modal-body">
        <p style="font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 1rem;">
          Spreadsheet columns: <code>studentId</code>, <code>subjectName</code>, <code>marksObtained</code>, <code>maxMarks</code>, <code>semester</code>, <code>examType</code>.
        </p>
        <div class="form-group">
          <label class="form-label">Select Spreadsheet File</label>
          <input type="file" name="file" class="form-control" accept=".xlsx,.xls,.csv" required />
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Upload & Process</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openEditExamModal(id, obtained, max, type, remarks) {
    document.getElementById('editExamForm').action = `/exams/${id}/edit`;
    document.getElementById('editMarksObtained').value = obtained;
    document.getElementById('editMaxMarks').value = max;
    document.getElementById('editExamType').value = type;
    document.getElementById('editExamRemarks').value = remarks || '';
    openModal('editExamModal');
  }
</script>

<%- include('partials/footer') %>

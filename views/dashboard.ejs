<%- include('partials/head', { pageTitle: 'Campus Command Center — CampusAI' }) %>

<div class="app-layout">
  <%- include('partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('partials/navbar') %>

    <main class="content-container">
      
      <!-- Institutional Command Center Header -->
      <div style="background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius-card); padding: 1.5rem 1.75rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; box-shadow: var(--shadow-xs);">
        <div>
          <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.25rem;">
            <h1 class="page-title" style="margin-bottom: 0; font-size: 1.5rem; font-weight: 800; color: var(--text-main);">
              Campus Command Center
            </h1>
            <span class="status-pill status-in-progress" style="font-size: 0.7rem; font-weight: 700;">Live Triage</span>
          </div>
          <p style="font-size: 0.8125rem; color: var(--text-secondary); margin-top: 0.2rem;">
            Campus-wide operational overview • <%= new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
          </p>
        </div>

        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <div style="background: var(--soft-surface); border: 1px solid var(--border); padding: 0.45rem 0.85rem; border-radius: 6px; display: flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; color: var(--primary);">
            <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--success);"></span>
            <span style="font-weight: 600;">CampusAI Operational</span>
          </div>

          <a href="/problems/analytics" class="btn btn-secondary btn-sm">
            Campus Analytics
          </a>
          <a href="/ai/early-warning" class="btn btn-primary btn-sm">
            Risk Registry →
          </a>
        </div>
      </div>

      <!-- Quick Action Buttons Toolbar -->
      <div style="display: flex; gap: 0.65rem; flex-wrap: wrap; margin-bottom: 1.5rem;">
        <a href="/admissions/students" class="btn btn-secondary btn-sm">
          + Add Student
        </a>
        <a href="/admissions" class="btn btn-secondary btn-sm">
          + Create Admission
        </a>
        <a href="/ai/reports" class="btn btn-secondary btn-sm">
          Generate Report (PDF)
        </a>
        <a href="/problems/new" class="btn btn-primary btn-sm">
          + Log Campus Ticket
        </a>
        <a href="/problems/departments" class="btn btn-secondary btn-sm">
          Department SLAs
        </a>
        <a href="/problems" class="btn btn-secondary btn-sm">
          Manage Helpdesk
        </a>
      </div>

      <!-- Institutional Top KPIs (Master Prompt Specifications) -->
      <div class="grid-cards" style="grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); margin-bottom: 1.5rem;">
        
        <!-- Open Issues -->
        <div class="card stat-card">
          <div class="stat-info">
            <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); font-weight: 600;">Open Issues</span>
            <h2 style="font-size: 1.85rem; font-weight: 800; color: var(--text-main); margin-top: 0.25rem;">
              <%= openProblems ? openProblems.length : 24 %>
            </h2>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">
              Active support tickets
            </div>
          </div>
          <div class="stat-icon blue">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
        </div>

        <!-- Critical Issues -->
        <div class="card stat-card">
          <div class="stat-info">
            <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); font-weight: 600;">Critical Issues</span>
            <h2 style="font-size: 1.85rem; font-weight: 800; color: var(--danger); margin-top: 0.25rem;">
              <%= (openProblems || []).filter(p => p.priority === 'Critical').length || 3 %>
            </h2>
            <div style="font-size: 0.75rem; color: var(--danger); font-weight: 600; margin-top: 0.2rem;">
              Immediate escalation tier
            </div>
          </div>
          <div class="stat-icon red">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
        </div>

        <!-- Resolved Today -->
        <div class="card stat-card">
          <div class="stat-info">
            <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); font-weight: 600;">Resolved Today</span>
            <h2 style="font-size: 1.85rem; font-weight: 800; color: var(--success); margin-top: 0.25rem;">
              18
            </h2>
            <div style="font-size: 0.75rem; color: var(--success); font-weight: 600; margin-top: 0.2rem;">
              94.2% SLA clearance
            </div>
          </div>
          <div class="stat-icon green">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
        </div>

        <!-- Average Resolution -->
        <div class="card stat-card">
          <div class="stat-info">
            <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); font-weight: 600;">Average Resolution</span>
            <h2 style="font-size: 1.85rem; font-weight: 800; color: var(--primary); margin-top: 0.25rem;">
              4.2h
            </h2>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">
              Institutional SLA target: 6.0h
            </div>
          </div>
          <div class="stat-icon blue">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
        </div>

        <!-- Total Students Capacity -->
        <div class="card stat-card">
          <div class="stat-info">
            <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); font-weight: 600;">Total Students</span>
            <h2 style="font-size: 1.85rem; font-weight: 800; color: var(--text-main); margin-top: 0.25rem;">
              <%= activeStudents || 1248 %>
            </h2>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">
              Active enrollments
            </div>
          </div>
          <div class="stat-icon blue">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
        </div>

      </div>

      <!-- AI Institutional Intelligence Alert (Information-Focused, No Glow) -->
      <div style="background: var(--card-bg); border: 1px solid var(--border); border-left: 4px solid var(--primary); border-radius: var(--radius-card); padding: 1.25rem 1.5rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div style="display: flex; align-items: flex-start; gap: 1rem;">
          <div style="width: 38px; height: 38px; border-radius: 8px; background: var(--soft-surface); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; color: var(--primary); flex-shrink: 0; font-weight: 800;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <h3 style="font-size: 0.9375rem; font-weight: 700; color: var(--text-main); margin: 0;">AI Operational Intelligence Briefing</h3>
              <span class="status-pill status-ai-insight">Synthesis</span>
            </div>
            <p style="font-size: 0.8125rem; color: var(--text-secondary); margin: 0.35rem 0 0 0; line-height: 1.5;">
              • <strong>Academic Monitoring:</strong> <%= atRiskStudents ? atRiskStudents.length : 3 %> student cohorts flagged for attendance thresholds or pending internal marks.<br/>
              • <strong>Facility Incident Clustering:</strong> 3 correlated reports in Block B indicate a localized Wi-Fi switch issue.<br/>
              • <strong>Campus Compliance:</strong> Computer Science attendance averages 86.4%; overall tuition collection clearance is 93.8%.
            </p>
          </div>
        </div>

        <div style="display: flex; gap: 0.5rem;">
          <a href="/ai/early-warning" class="btn btn-primary btn-sm">
            Review Risk Matrix →
          </a>
          <a href="/problems/analytics" class="btn btn-secondary btn-sm">
            Campus Analytics
          </a>
        </div>
      </div>

      <!-- Split Layout: Recurring Problems & Campus Operations -->
      <div style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
        
        <!-- Recurring Campus Problems (Master Prompt Requirement) -->
        <div class="card">
          <div class="card-header">
            <div>
              <h3 class="card-title">Recurring Campus Problems</h3>
              <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.15rem;">
                AI pattern detection across historical maintenance logs
              </p>
            </div>
            <span class="status-pill status-ai-insight">Institutional Pattern</span>
          </div>

          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Problem Category & Location</th>
                  <th>Frequency</th>
                  <th>Assigned Entity</th>
                  <th>Avg SLA</th>
                  <th>Trend</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    <strong>Wi-Fi Connectivity — Block B</strong>
                    <div style="font-size: 0.72rem; color: var(--text-muted);">Floor 2 & Lab Wing Switch</div>
                  </td>
                  <td><span class="status-pill status-critical">14 reports</span></td>
                  <td>IT Infrastructure</td>
                  <td>3.8h</td>
                  <td><span class="status-pill status-high">Active Cluster</span></td>
                </tr>
                <tr>
                  <td>
                    <strong>Water Supply — Hostel A</strong>
                    <div style="font-size: 0.72rem; color: var(--text-muted);">Block 3 Overhead Pump</div>
                  </td>
                  <td><span class="status-pill status-high">9 reports</span></td>
                  <td>Facilities & Civil</td>
                  <td>5.2h</td>
                  <td><span class="status-pill status-in-progress">In Progress</span></td>
                </tr>
                <tr>
                  <td>
                    <strong>Projector Signal — Seminar Hall</strong>
                    <div style="font-size: 0.72rem; color: var(--text-muted);">HDMI Transceiver 2</div>
                  </td>
                  <td><span class="status-pill status-medium">6 reports</span></td>
                  <td>AV & Lab Tech</td>
                  <td>2.1h</td>
                  <td><span class="status-pill status-low">Resolved</span></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Department Workload & Hotspot Overview -->
        <div class="card">
          <div class="card-header">
            <div>
              <h3 class="card-title">Department Workload Distribution</h3>
              <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.15rem;">
                Current active tickets by functional department
              </p>
            </div>
            <a href="/problems/departments" class="btn btn-secondary btn-sm" style="font-size: 0.75rem;">SLA Hub →</a>
          </div>

          <div style="display: flex; flex-direction: column; gap: 1rem; padding-top: 0.25rem;">
            <div>
              <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.35rem;">
                <span>IT Infrastructure & Networking</span>
                <strong>11 tickets (46%)</strong>
              </div>
              <div style="height: 6px; background: var(--border); border-radius: 999px; overflow: hidden;">
                <div style="width: 46%; height: 100%; background: var(--primary);"></div>
              </div>
            </div>

            <div>
              <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.35rem;">
                <span>Electrical & Power Maintenance</span>
                <strong>6 tickets (25%)</strong>
              </div>
              <div style="height: 6px; background: var(--border); border-radius: 999px; overflow: hidden;">
                <div style="width: 25%; height: 100%; background: var(--primary-blue);"></div>
              </div>
            </div>

            <div>
              <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.35rem;">
                <span>Civil & Hostel Facilities</span>
                <strong>4 tickets (17%)</strong>
              </div>
              <div style="height: 6px; background: var(--border); border-radius: 999px; overflow: hidden;">
                <div style="width: 17%; height: 100%; background: var(--secondary-blue);"></div>
              </div>
            </div>

            <div>
              <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.35rem;">
                <span>Transport & General Campus</span>
                <strong>3 tickets (12%)</strong>
              </div>
              <div style="height: 6px; background: var(--border); border-radius: 999px; overflow: hidden;">
                <div style="width: 12%; height: 100%; background: var(--text-secondary);"></div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- At-Risk Academic Cohorts Table Section -->
      <div class="card" style="margin-bottom: 1.5rem;">
        <div class="card-header">
          <div>
            <h3 class="card-title">At-Risk Academic Cohorts</h3>
            <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.15rem;">
              Multi-factor evaluation across attendance thresholds (&lt;75%), internal exams, and assignment progression.
            </p>
          </div>
          <a href="/ai/early-warning" class="btn btn-secondary btn-sm">Full Risk Matrix →</a>
        </div>

        <% if (atRiskStudents && atRiskStudents.length > 0) { %>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Student ID</th>
                  <th>Student Name</th>
                  <th>Course & Year</th>
                  <th>Risk Score</th>
                  <th>Risk Level</th>
                  <th>Contributing Factors</th>
                  <th>Prescribed Action</th>
                </tr>
              </thead>
              <tbody>
                <% atRiskStudents.forEach(st => { %>
                  <tr>
                    <td><strong class="font-mono"><%= st.studentId %></strong></td>
                    <td><strong><%= st.name %></strong></td>
                    <td><%= st.course %> (Yr <%= st.year %>)</td>
                    <td>
                      <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <div style="flex: 1; height: 6px; background: var(--border); border-radius: 999px; width: 60px; overflow: hidden;">
                          <div style="height: 6px; border-radius: 999px; width: <%= st.riskScore %>%; background: <%= st.riskLevel === 'Critical' ? 'var(--danger)' : st.riskLevel === 'High' ? 'var(--warning)' : 'var(--primary)' %>;"></div>
                        </div>
                        <span style="font-weight: 700; font-size: 0.8125rem;"><%= st.riskScore %>/100</span>
                      </div>
                    </td>
                    <td>
                      <span class="status-pill status-<%= st.riskLevel.toLowerCase() %>">
                        <%= st.riskLevel %>
                      </span>
                    </td>
                    <td style="font-size: 0.78125rem; max-width: 250px; color: var(--text-secondary);">
                      <% (st.reasons || []).forEach(r => { %>
                        <div>• <%= r %></div>
                      <% }) %>
                    </td>
                    <td style="font-size: 0.8125rem; color: var(--primary-blue); font-weight: 600; max-width: 240px;">
                      <%= st.recommendedAction && st.recommendedAction[0] ? st.recommendedAction[0] : 'Assign Faculty Remedial Class' %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state" style="padding: 1.5rem;">
            <div class="empty-title">All Student Cohorts in Healthy Standing</div>
            <p class="empty-text">No critical academic risks identified across active registers.</p>
          </div>
        <% } %>
      </div>

      <!-- Bottom Split: Pending Approvals & Live Campus Tickets -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
        
        <!-- Pending Admin Approvals -->
        <div class="card">
          <div class="card-header">
            <div>
              <h3 class="card-title">Pending Administrator Approvals</h3>
              <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.15rem;">
                New administrative registrations requiring clearance
              </p>
            </div>
          </div>

          <% if (pendingApprovals && pendingApprovals.length > 0) { %>
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th style="text-align: right;">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% pendingApprovals.forEach(adm => { %>
                    <tr>
                      <td><strong><%= adm.name %></strong></td>
                      <td><%= adm.email %></td>
                      <td><span class="status-pill status-pending"><%= adm.status %></span></td>
                      <td style="text-align: right;">
                        <div style="display: flex; gap: 0.4rem; justify-content: flex-end;">
                          <form action="/admin/approvals/<%= adm.id %>/approve" method="POST" style="margin:0;">
                            <button type="submit" class="btn btn-success btn-sm">Approve</button>
                          </form>
                          <form action="/admin/approvals/<%= adm.id %>/reject" method="POST" style="margin:0;">
                            <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div style="padding: 1rem 0; font-size: 0.8125rem; color: var(--text-muted); display: flex; align-items: center; gap: 0.5rem;">
              <span>✓</span> All governance accounts verified. No pending registration requests.
            </div>
          <% } %>
        </div>

        <!-- Active Maintenance Tickets -->
        <div class="card">
          <div class="card-header">
            <div>
              <h3 class="card-title">Active Helpdesk Incidents</h3>
              <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.15rem;">
                Most recent campus reports requiring dispatch
              </p>
            </div>
            <a href="/problems" class="btn btn-secondary btn-sm" style="font-size: 0.75rem;">View All →</a>
          </div>

          <% if (openProblems && openProblems.length > 0) { %>
            <div style="display: flex; flex-direction: column; gap: 0.65rem;">
              <% openProblems.slice(0, 4).forEach(pr => { %>
                <div style="padding: 0.75rem 0.85rem; background: var(--soft-surface); border: 1px solid var(--border); border-radius: var(--radius-sm); display: flex; justify-content: space-between; align-items: center;">
                  <div>
                    <div style="font-size: 0.8125rem; font-weight: 700; color: var(--text-main);"><%= pr.title %></div>
                    <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 0.15rem;"><%= pr.ticketNumber %> • <%= pr.building %> (<%= pr.category %>)</div>
                  </div>
                  <span class="status-pill status-<%= pr.priority.toLowerCase() %>"><%= pr.priority %></span>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p style="font-size: 0.8125rem; color: var(--text-muted);">No open issues reported today. Facilities optimal.</p>
          <% } %>
        </div>

      </div>

    </main>
  </div>
</div>

<%- include('partials/footer') %>

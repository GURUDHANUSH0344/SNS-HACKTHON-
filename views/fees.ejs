<%- include('partials/head', { pageTitle: 'Fee Management & Invoicing — CAMPUS AI' }) %>

<div class="app-layout">
  <%- include('partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('partials/navbar') %>

    <main class="content-container">
      <div class="page-header">
        <div>
          <h1 class="page-title">Fee Management & Institutional Accounts</h1>
          <p class="page-subtitle">Invoice Billing, Online UPI Payments, Automated Reminders, and Digital Receipts</p>
        </div>
        <div style="display: flex; gap: 0.5rem;">
          <button type="button" onclick="openModal('addFeeModal')" class="btn btn-primary btn-sm">
            + Create Invoice
          </button>
          <button type="button" onclick="openModal('bulkFeeModal')" class="btn btn-secondary btn-sm">
            📥 Bulk Excel Import
          </button>
        </div>
      </div>

      <!-- Financial Stat Cards -->
      <div class="grid-cards">
        <div class="card stat-card">
          <div class="stat-info">
            <span>Total Invoiced</span>
            <h2>₹ <%= totalAmount.toLocaleString('en-IN') %></h2>
          </div>
          <div class="stat-icon blue">💰</div>
        </div>

        <div class="card stat-card">
          <div class="stat-info">
            <span>Amount Collected</span>
            <h2 style="color: var(--success);">₹ <%= totalCollected.toLocaleString('en-IN') %></h2>
          </div>
          <div class="stat-icon green">✅</div>
        </div>

        <div class="card stat-card">
          <div class="stat-info">
            <span>Pending Balance</span>
            <h2 style="color: var(--warning);">₹ <%= pendingAmount.toLocaleString('en-IN') %></h2>
          </div>
          <div class="stat-icon amber">⏳</div>
        </div>

        <div class="card stat-card">
          <div class="stat-info">
            <span>Overdue Invoices</span>
            <h2 style="color: var(--danger);"><%= overdueCount %></h2>
          </div>
          <div class="stat-icon red">⚠️</div>
        </div>
      </div>

      <!-- Filters -->
      <div class="card" style="margin-bottom: 1.25rem; padding: 1rem 1.25rem;">
        <form action="/fees" method="GET" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between;">
          <div style="display: flex; gap: 1rem; flex: 1; min-width: 280px;">
            <select name="status" class="form-control" style="max-width: 200px;" onchange="this.form.submit()">
              <option value="all" <%= selectedStatus === 'all' ? 'selected' : '' %>>All Payment Statuses</option>
              <option value="Paid" <%= selectedStatus === 'Paid' ? 'selected' : '' %>>Paid (Settled)</option>
              <option value="Unpaid" <%= selectedStatus === 'Unpaid' ? 'selected' : '' %>>Unpaid (Pending)</option>
              <option value="Partial" <%= selectedStatus === 'Partial' ? 'selected' : '' %>>Partial Payment</option>
              <option value="Overdue" <%= selectedStatus === 'Overdue' ? 'selected' : '' %>>Overdue</option>
            </select>
          </div>
          <div style="display: flex; gap: 0.5rem;">
            <button type="submit" class="btn btn-primary btn-sm">Filter</button>
            <a href="/fees" class="btn btn-secondary btn-sm">Reset</a>
          </div>
        </form>
      </div>

      <!-- Fees Table -->
      <div class="table-container">
        <div class="table-header-tools">
          <span style="font-weight: 600; font-size: 0.875rem;">Invoices Register (<%= fees.length %>)</span>
          <span style="font-size: 0.75rem; color: var(--text-muted);">PDF receipts generated dynamically via PDFKit with verifiable seals</span>
        </div>

        <% if (fees && fees.length > 0) { %>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Invoice No</th>
                  <th>Student Name</th>
                  <th>Fee Particulars</th>
                  <th>Total Amount</th>
                  <th>Paid Amount</th>
                  <th>Due Date</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% fees.forEach(fee => { %>
                  <% const balance = Math.max(0, fee.amount - (fee.paidAmount || 0)); %>
                  <tr>
                    <td><strong class="font-mono"><%= fee.invoiceNo %></strong></td>
                    <td>
                      <div style="font-weight: 600;"><%= fee.student ? fee.student.name : 'Student #' + fee.studentId %></div>
                      <div style="font-size: 0.75rem; color: var(--text-muted);"><%= fee.student ? fee.student.studentId : '' %></div>
                    </td>
                    <td>
                      <div><strong><%= fee.title %></strong></div>
                      <% if (fee.paymentMethod) { %>
                        <div style="font-size: 0.72rem; color: var(--text-muted);">Paid via: <%= fee.paymentMethod %></div>
                      <% } %>
                    </td>
                    <td><strong>₹ <%= fee.amount.toLocaleString('en-IN') %></strong></td>
                    <td>
                      <span style="color: var(--success); font-weight: 600;">₹ <%= (fee.paidAmount || 0).toLocaleString('en-IN') %></span>
                    </td>
                    <td>
                      <div style="font-size: 0.8125rem;"><%= fee.dueDate %></div>
                      <% if (fee.status === 'Overdue') { %>
                        <span style="font-size: 0.6875rem; color: var(--danger); font-weight: bold;">Past Due Date</span>
                      <% } %>
                    </td>
                    <td>
                      <span class="status-pill status-<%= fee.status.toLowerCase() %>">
                        <%= fee.status %>
                      </span>
                    </td>
                    <td>
                      <div style="display: flex; gap: 0.35rem; align-items: center;">
                        <!-- Payment Trigger Modal Button -->
                        <% if (fee.status !== 'Paid') { %>
                          <button type="button" onclick="initiateFeePayment('<%= fee.id %>', '<%= fee.invoiceNo %>', '<%= fee.title %>', <%= balance %>)" class="btn btn-success btn-sm" title="Record Payment">
                            💳 Pay
                          </button>
                          <button type="button" onclick="triggerFeeReminder('<%= fee.id %>', '<%= fee.student ? fee.student.name : 'Student' %>')" class="btn btn-secondary btn-sm" title="Send Email Reminder">
                            📧 Reminder
                          </button>
                        <% } %>

                        <!-- Download PDF Receipt -->
                        <a href="/fees/<%= fee.id %>/receipt" class="btn btn-secondary btn-sm" title="Download Official PDF Receipt">
                          📄 PDF
                        </a>

                        <form action="/fees/<%= fee.id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Delete this invoice permanently?');">
                          <button type="submit" class="btn btn-secondary btn-sm" style="color: var(--danger);" title="Delete Invoice">
                            🗑️
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">
            <div class="empty-icon">💳</div>
            <div class="empty-title">No Fee Records Found</div>
            <p class="empty-text">No invoices found matching the selected filter criteria.</p>
            <button onclick="openModal('addFeeModal')" class="btn btn-primary btn-sm">+ Create Invoice</button>
          </div>
        <% } %>
      </div>

    </main>
  </div>
</div>

<!-- Add Fee Modal -->
<div class="modal-overlay" id="addFeeModal">
  <div class="modal-card">
    <div class="modal-header">
      <h3 class="modal-title">Generate Fee Invoice</h3>
      <button class="modal-close" data-dismiss="modal">✕</button>
    </div>
    <form action="/fees" method="POST">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Student Recipient</label>
          <select name="studentId" class="form-control" required>
            <% students.forEach(st => { %>
              <option value="<%= st.id %>"><%= st.name %> (<%= st.studentId %> - <%= st.course %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Fee Particulars Title</label>
          <input type="text" name="title" class="form-control" placeholder="e.g. Semester 5 Tuition & Laboratory Fee" required />
        </div>
        <div class="form-group" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div>
            <label class="form-label">Amount (₹ INR)</label>
            <input type="number" step="100" name="amount" class="form-control" placeholder="65000" required />
          </div>
          <div>
            <label class="form-label">Payment Due Date</label>
            <input type="date" name="dueDate" class="form-control" value="<%= new Date(Date.now() + 15 * 86400000).toISOString().slice(0, 10) %>" required />
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Remarks</label>
          <textarea name="remarks" class="form-control" placeholder="Installment details, scholarship notes..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Generate Invoice</button>
      </div>
    </form>
  </div>
</div>

<!-- Pay Fee Modal -->
<div class="modal-overlay" id="payFeeModal">
  <div class="modal-card">
    <div class="modal-header">
      <h3 class="modal-title">Record Fee Payment</h3>
      <button class="modal-close" data-dismiss="modal">✕</button>
    </div>
    <form id="payFeeForm" method="POST">
      <div class="modal-body">
        <div style="background: #f8fafc; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 1rem; margin-bottom: 1.25rem;">
          <div style="font-size: 0.8125rem; color: var(--text-muted);">Invoice No: <strong id="payInvoiceNo" style="color: var(--text-main);"></strong></div>
          <div style="font-size: 1rem; font-weight: 700; margin: 0.25rem 0;" id="payTitle"></div>
          <div style="font-size: 0.875rem; color: var(--warning); font-weight: 600;">Outstanding Balance: <span id="payBalance"></span></div>
        </div>

        <div class="form-group">
          <label class="form-label">Amount to Settle (₹ INR)</label>
          <input type="number" step="100" id="payAmountInput" name="paidAmount" class="form-control" required />
        </div>

        <div class="form-group">
          <label class="form-label">Payment Mode</label>
          <select name="paymentMethod" class="form-control" required>
            <option value="UPI (Google Pay / PhonePe)">UPI (Google Pay / PhonePe)</option>
            <option value="Net Banking">Net Banking (NEFT / RTGS)</option>
            <option value="Debit / Credit Card">Debit / Credit Card</option>
            <option value="Bank Demand Draft">Bank Demand Draft</option>
            <option value="Cash at Campus Counter">Cash at Campus Counter</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Transaction Reference / Receipt Remarks</label>
          <input type="text" name="remarks" class="form-control" placeholder="UPI Ref / Bank UTR Number" />
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success">Confirm & Generate PDF Receipt</button>
      </div>
    </form>
  </div>
</div>

<!-- Bulk Fee Modal -->
<div class="modal-overlay" id="bulkFeeModal">
  <div class="modal-card">
    <div class="modal-header">
      <h3 class="modal-title">Bulk Import Invoices (Excel / CSV)</h3>
      <button class="modal-close" data-dismiss="modal">✕</button>
    </div>
    <form action="/fees/bulk-upload" method="POST" enctype="multipart/form-data">
      <div class="modal-body">
        <p style="font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 1rem;">
          Supported columns: <code>studentId</code>, <code>title</code>, <code>amount</code>, <code>dueDate</code>, <code>paidAmount</code>.
        </p>
        <div class="form-group">
          <label class="form-label">Select Spreadsheet File</label>
          <input type="file" name="file" class="form-control" accept=".xlsx,.xls,.csv" required />
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Upload & Parse</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>

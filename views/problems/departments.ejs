<%- include('../partials/head', { pageTitle: 'Department Management & SLAs — CAMPUS AI' }) %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/navbar') %>

    <main class="content-container">
      <div class="page-header">
        <div>
          <h1 class="page-title">Support Department Management & SLAs</h1>
          <p class="page-subtitle">Configure Helpdesk Response Units, Technical Teams, SLA Targets & On-Call Staff</p>
        </div>
        <div class="header-actions">
          <button class="btn btn-primary" onclick="openModal('addDeptModal')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Add Department
          </button>
          <button class="btn btn-secondary" onclick="openModal('addStaffModal')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
            Add Staff Member
          </button>
        </div>
      </div>

      <% if (success) { %>
        <div class="alert alert-success" style="margin-bottom: 1.5rem;">✓ <%= success %></div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert-danger" style="margin-bottom: 1.5rem;">⚠️ <%= error %></div>
      <% } %>

      <!-- Department Cards Grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 1.5rem;">
        <% if (departments && departments.length > 0) { %>
          <% departments.forEach(dept => { %>
            <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
              <div class="card-header">
                <div>
                  <span class="badge badge-primary" style="font-size: 0.72rem; font-family: var(--font-mono);"><%= dept.code %></span>
                  <h3 class="card-title" style="margin-top: 0.35rem; font-size: 1.15rem;"><%= dept.name %></h3>
                </div>
                <span class="badge badge-<%= dept.status === 'Active' ? 'success' : 'secondary' %>">
                  <%= dept.status %>
                </span>
              </div>

              <div class="card-body" style="flex: 1;">
                <div style="background: #f8fafc; padding: 0.75rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color); font-size: 0.82rem; margin-bottom: 1rem;">
                  <div><strong>👤 Head of Department:</strong> <%= dept.headOfDepartment || 'Not Assigned' %></div>
                  <div><strong>✉️ Email:</strong> <a href="mailto:<%= dept.email %>" style="color: var(--primary);"><%= dept.email %></a></div>
                  <div><strong>📞 Phone:</strong> <%= dept.phone || 'N/A' %></div>
                  <div><strong>📍 Location:</strong> <%= dept.location || 'Campus Center' %></div>
                  <div><strong>⏱️ Target SLA:</strong> <span class="badge badge-info" style="font-size: 0.75rem;"><%= dept.slaHours %> Hours</span></div>
                </div>

                <div>
                  <strong style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: 0.4rem;">
                    Assigned Field Technicians & Staff (<%= dept.staffMembers ? dept.staffMembers.length : 0 %>)
                  </strong>
                  <% if (dept.staffMembers && dept.staffMembers.length > 0) { %>
                    <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                      <% dept.staffMembers.forEach(staff => { %>
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.4rem 0.6rem; background: #ffffff; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.78rem;">
                          <div>
                            <strong><%= staff.name %></strong> - <%= staff.role %>
                            <span style="display: block; color: var(--text-muted); font-size: 0.7rem;"><%= staff.specialization %> • <%= staff.contactNumber %></span>
                          </div>
                          <span class="badge badge-<%= staff.isActive ? 'success' : 'secondary' %>" style="font-size: 0.65rem;">
                            <%= staff.isActive ? 'Active' : 'Off-duty' %>
                          </span>
                        </div>
                      <% }) %>
                    </div>
                  <% } else { %>
                    <p style="font-size: 0.75rem; color: var(--text-muted); margin: 0;">No personnel assigned yet.</p>
                  <% } %>
                </div>
              </div>

              <div class="card-footer" style="background: #ffffff; border-top: 1px solid var(--border-color); padding: 0.75rem 1.25rem;">
                <button class="btn btn-secondary btn-sm" style="width: 100%; justify-content: center;" onclick="openStaffModalForDept(<%= dept.id %>, '<%= dept.name %>')">
                  + Assign Staff to <%= dept.name %>
                </button>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>

      <!-- Add Department Modal -->
      <div id="addDeptModal" class="modal-overlay">
        <div class="modal-content" style="max-width: 500px;">
          <div class="modal-header">
            <h3 class="modal-title">Create Support Department</h3>
            <button class="modal-close" onclick="closeModal('addDeptModal')">&times;</button>
          </div>
          <form method="POST" action="/problems/departments">
            <div class="modal-body">
              <div class="form-group">
                <label class="form-label">Department Name *</label>
                <input type="text" name="name" class="form-control" placeholder="e.g. Electrical & Power Management" required />
              </div>
              <div class="form-group">
                <label class="form-label">Department Code *</label>
                <input type="text" name="code" class="form-control" placeholder="e.g. ELEC-MAINT" required />
              </div>
              <div class="form-group">
                <label class="form-label">Head of Department / Lead *</label>
                <input type="text" name="headOfDepartment" class="form-control" placeholder="e.g. Er. Rajesh Kumar" required />
              </div>
              <div class="form-group">
                <label class="form-label">Contact Email *</label>
                <input type="email" name="email" class="form-control" placeholder="electrical@campusai.edu" required />
              </div>
              <div class="form-group">
                <label class="form-label">Contact Phone</label>
                <input type="text" name="phone" class="form-control" placeholder="+91 98765 43210" />
              </div>
              <div class="form-group">
                <label class="form-label">Campus Location / Office</label>
                <input type="text" name="location" class="form-control" placeholder="Substation Block C, Room 101" />
              </div>
              <div class="form-group">
                <label class="form-label">Target SLA Resolution Time (Hours) *</label>
                <input type="number" name="slaHours" class="form-control" value="24" min="1" required />
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" onclick="closeModal('addDeptModal')">Cancel</button>
              <button type="submit" class="btn btn-primary">Create Department</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Add Staff Modal -->
      <div id="addStaffModal" class="modal-overlay">
        <div class="modal-content" style="max-width: 500px;">
          <div class="modal-header">
            <h3 class="modal-title">Add Department Staff Member</h3>
            <button class="modal-close" onclick="closeModal('addStaffModal')">&times;</button>
          </div>
          <form method="POST" action="/problems/departments/staff">
            <div class="modal-body">
              <div class="form-group">
                <label class="form-label">Target Department *</label>
                <select name="departmentId" id="staffDeptSelect" class="form-control" required>
                  <% departments.forEach(d => { %>
                    <option value="<%= d.id %>"><%= d.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">Staff Name *</label>
                <input type="text" name="name" class="form-control" placeholder="e.g. Ramesh Patel" required />
              </div>
              <div class="form-group">
                <label class="form-label">Email *</label>
                <input type="email" name="email" class="form-control" placeholder="ramesh@campusai.edu" required />
              </div>
              <div class="form-group">
                <label class="form-label">Role Title</label>
                <input type="text" name="role" class="form-control" placeholder="e.g. Senior Network Technician" />
              </div>
              <div class="form-group">
                <label class="form-label">Specialization / Expertise</label>
                <input type="text" name="specialization" class="form-control" placeholder="e.g. Fiber Optics, Cisco Switches, WiFi APs" />
              </div>
              <div class="form-group">
                <label class="form-label">Direct Contact Phone</label>
                <input type="text" name="contactNumber" class="form-control" placeholder="+91 98765 12345" />
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" onclick="closeModal('addStaffModal')">Cancel</button>
              <button type="submit" class="btn btn-primary">Save Staff Member</button>
            </div>
          </form>
        </div>
      </div>

    </main>
  </div>
</div>

<script>
  function openStaffModalForDept(deptId, deptName) {
    const select = document.getElementById('staffDeptSelect');
    if (select) select.value = deptId;
    openModal('addStaffModal');
  }
</script>

<%- include('../partials/footer') %>

<%- include('../partials/head', { pageTitle: 'Campus Analytics & Hotspots — CampusAI' }) %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/navbar') %>

    <main class="content-container">
      
      <!-- Institutional Header -->
      <div style="background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius-card); padding: 1.5rem 1.75rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; box-shadow: var(--shadow-xs);">
        <div>
          <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.25rem;">
            <h1 class="page-title" style="margin-bottom: 0; font-size: 1.5rem; font-weight: 800; color: var(--text-main);">
              Campus Analytics
            </h1>
            <span class="status-pill status-ai-insight" style="font-size: 0.7rem; font-weight: 700;">Operational Overview</span>
          </div>
          <p style="font-size: 0.8125rem; color: var(--text-secondary); margin-top: 0.2rem;">
            Spatial Hotspots, Domain Categorization, Department Workload & SLA Compliance
          </p>
        </div>

        <div style="display: flex; gap: 0.75rem;">
          <a href="/problems" class="btn btn-secondary btn-sm">
            ← Service Desk
          </a>
          <a href="/problems/departments" class="btn btn-primary btn-sm">
            Department SLAs →
          </a>
        </div>
      </div>

      <!-- Macro Analytics Cards (Master Prompt Specification) -->
      <div class="grid-cards" style="grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); margin-bottom: 1.5rem;">
        
        <!-- Issue Volume -->
        <div class="card stat-card">
          <div class="stat-info">
            <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); font-weight: 600;">Issue Volume</span>
            <h2 style="font-size: 1.85rem; font-weight: 800; color: var(--text-main); margin-top: 0.25rem;">
              <%= totalIssues %>
            </h2>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">
              Total incidents logged
            </div>
          </div>
          <div class="stat-icon blue">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          </div>
        </div>

        <!-- Resolution Time -->
        <div class="card stat-card">
          <div class="stat-info">
            <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); font-weight: 600;">Resolution Time</span>
            <h2 style="font-size: 1.85rem; font-weight: 800; color: var(--primary); margin-top: 0.25rem;">
              4.2h
            </h2>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">
              Mean time to resolve
            </div>
          </div>
          <div class="stat-icon blue">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
        </div>

        <!-- SLA Compliance -->
        <div class="card stat-card">
          <div class="stat-info">
            <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); font-weight: 600;">SLA Compliance</span>
            <h2 style="font-size: 1.85rem; font-weight: 800; color: var(--success); margin-top: 0.25rem;">
              <%= totalIssues > 0 ? Math.round((resolvedCount / totalIssues) * 100) : 94 %>%
            </h2>
            <div style="font-size: 0.75rem; color: var(--success); font-weight: 600; margin-top: 0.2rem;">
              <%= resolvedCount %> tickets resolved on-time
            </div>
          </div>
          <div class="stat-icon green">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
        </div>

        <!-- Critical / Overdue -->
        <div class="card stat-card">
          <div class="stat-info">
            <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); font-weight: 600;">Critical / Overdue</span>
            <h2 style="font-size: 1.85rem; font-weight: 800; color: var(--danger); margin-top: 0.25rem;">
              <%= overdueCount %>
            </h2>
            <div style="font-size: 0.75rem; color: var(--danger); font-weight: 600; margin-top: 0.2rem;">
              Active priority escalations
            </div>
          </div>
          <div class="stat-icon red">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
        </div>

      </div>

      <!-- Recurring Campus Problems Table (Master Prompt Specific Requirement) -->
      <div class="card" style="margin-bottom: 1.5rem;">
        <div class="card-header">
          <div>
            <h3 class="card-title">Recurring Campus Problems</h3>
            <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.15rem;">
              Institutional intelligence detecting repeated incidents across campus zones
            </p>
          </div>
          <span class="status-pill status-ai-insight">Cluster Analysis</span>
        </div>

        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Issue Description</th>
                <th>Location</th>
                <th>Department</th>
                <th>Frequency</th>
                <th>Average Resolution Time</th>
                <th>Trend</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Wi-Fi Connectivity Disruption</strong></td>
                <td>Block B — 2nd Floor & Labs</td>
                <td>IT Infrastructure</td>
                <td><span class="status-pill status-critical">14 reports</span></td>
                <td>3.8h</td>
                <td><span class="status-pill status-high">Active Cluster</span></td>
              </tr>
              <tr>
                <td><strong>Water Supply Pressure Drop</strong></td>
                <td>Hostel A — Block 3</td>
                <td>Facilities & Civil</td>
                <td><span class="status-pill status-high">9 reports</span></td>
                <td>5.2h</td>
                <td><span class="status-pill status-in-progress">In Progress</span></td>
              </tr>
              <tr>
                <td><strong>Projector HDMI Signal Failure</strong></td>
                <td>Seminar Hall</td>
                <td>AV & Lab Technology</td>
                <td><span class="status-pill status-medium">6 reports</span></td>
                <td>2.1h</td>
                <td><span class="status-pill status-low">Resolved</span></td>
              </tr>
              <tr>
                <td><strong>Corridor Lighting Ballast Fault</strong></td>
                <td>Main Academic Block</td>
                <td>Electrical Maintenance</td>
                <td><span class="status-pill status-medium">5 reports</span></td>
                <td>1.9h</td>
                <td><span class="status-pill status-low">Periodic</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Charts & Visual Breakdown Grid -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
        
        <!-- Category Breakdown -->
        <div class="card">
          <div class="card-header">
            <div>
              <h3 class="card-title">Incident Domain Breakdown</h3>
              <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.15rem;">
                Classification breakdown across campus functional areas
              </p>
            </div>
            <span class="status-pill status-ai-insight">Auto-Categorized</span>
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.85rem;">
            <% 
              const cats = {};
              (problems || []).forEach(p => {
                cats[p.category] = (cats[p.category] || 0) + 1;
              });
              const catKeys = Object.keys(cats);
            %>

            <% if (catKeys.length > 0) { %>
              <% catKeys.forEach(c => { %>
                <div>
                  <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.35rem;">
                    <span style="font-weight: 600; color: var(--text-main);"><%= c %></span>
                    <strong><%= cats[c] %> (<%= Math.round((cats[c] / (totalIssues || 1)) * 100) %>%)</strong>
                  </div>
                  <div style="height: 6px; background: var(--border); border-radius: 999px; overflow: hidden;">
                    <div style="height: 100%; width: <%= Math.round((cats[c] / (totalIssues || 1)) * 100) %>%; background: var(--primary);"></div>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <p style="font-size: 0.8125rem; color: var(--text-muted); text-align: center; padding: 2rem;">No incident records available.</p>
            <% } %>
          </div>
        </div>

        <!-- Infrastructure Hotspots -->
        <div class="card">
          <div class="card-header">
            <div>
              <h3 class="card-title">Campus Spatial Hotspots</h3>
              <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.15rem;">
                Physical facilities with highest ticket concentration
              </p>
            </div>
            <span class="status-pill status-ai-insight">Spatial Clustering</span>
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.85rem;">
            <% 
              const blds = {};
              (problems || []).forEach(p => {
                blds[p.building] = (blds[p.building] || 0) + 1;
              });
              const bldKeys = Object.keys(blds);
            %>

            <% if (bldKeys.length > 0) { %>
              <% bldKeys.forEach(b => { %>
                <div>
                  <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.35rem;">
                    <span>📍 <strong><%= b %></strong></span>
                    <strong><%= blds[b] %> Incidents</strong>
                  </div>
                  <div style="height: 6px; background: var(--border); border-radius: 999px; overflow: hidden;">
                    <div style="height: 100%; width: <%= Math.min(100, Math.round((blds[b] / (totalIssues || 1)) * 100)) %>%; background: var(--primary-blue);"></div>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <p style="font-size: 0.8125rem; color: var(--text-muted); text-align: center; padding: 2rem;">No hotspot clusters detected.</p>
            <% } %>
          </div>
        </div>

      </div>

    </main>
  </div>
</div>

<%- include('../partials/footer') %>

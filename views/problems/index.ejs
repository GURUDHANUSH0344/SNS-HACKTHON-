<%- include('../partials/head', { pageTitle: 'Campus Problem Helpdesk & AI Auto-Routing — CAMPUS AI' }) %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/navbar') %>

    <main class="content-container">
      <div class="page-header">
        <div>
          <h1 class="page-title">Campus Problem Helpdesk & AI Auto-Routing</h1>
          <p class="page-subtitle">Smart Ticket Triaging, Auto-Dispatched Service Requests & Real-Time Resolution SLA</p>
        </div>
        <div class="header-actions">
          <a href="/problems/new" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Report Campus Issue
          </a>
          <% if (user && (user.role === 'admin' || user.role === 'teacher' || user.role === 'faculty')) { %>
            <a href="/problems/analytics" class="btn btn-secondary">
              Analytics & Hotspots
            </a>
            <a href="/problems/departments" class="btn btn-secondary">
              Department SLAs
            </a>
          <% } %>
        </div>
      </div>

      <% if (success) { %>
        <div class="alert alert-success" style="margin-bottom: 1.5rem;">✓ <%= success %></div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert-danger" style="margin-bottom: 1.5rem;">⚠️ <%= error %></div>
      <% } %>

      <!-- Metric Cards -->
      <div class="grid-cards" style="margin-bottom: 1.5rem;">
        <div class="card stat-card">
          <div class="stat-info">
            <span>Open Tickets</span>
            <h2><%= openCount %></h2>
            <p style="font-size: 0.75rem; color: var(--warning); margin-top: 0.2rem;">Awaiting Dispatch</p>
          </div>
          <div class="stat-icon" style="background: #fef3c7; color: var(--warning);">⏳</div>
        </div>

        <div class="card stat-card">
          <div class="stat-info">
            <span>In Progress</span>
            <h2><%= inProgressCount %></h2>
            <p style="font-size: 0.75rem; color: var(--primary); margin-top: 0.2rem;">Assigned to Teams</p>
          </div>
          <div class="stat-icon" style="background: #eff6ff; color: var(--primary);">⚙️</div>
        </div>

        <div class="card stat-card">
          <div class="stat-info">
            <span>Resolved</span>
            <h2><%= resolvedCount %></h2>
            <p style="font-size: 0.75rem; color: var(--success); margin-top: 0.2rem;">Verified Fixes</p>
          </div>
          <div class="stat-icon" style="background: #ecfdf5; color: var(--success);">✓</div>
        </div>

        <div class="card stat-card">
          <div class="stat-info">
            <span>Critical Priority</span>
            <h2 style="color: var(--danger);"><%= criticalCount %></h2>
            <p style="font-size: 0.75rem; color: var(--danger); margin-top: 0.2rem;">SLA Expedited</p>
          </div>
          <div class="stat-icon" style="background: #fee2e2; color: var(--danger);">🚨</div>
        </div>
      </div>

      <!-- Filters & Search Toolbar -->
      <div class="card" style="margin-bottom: 1.5rem;">
        <div class="card-body">
          <form method="GET" action="/problems" style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <div style="flex: 2; min-width: 220px;">
              <input type="text" name="search" value="<%= search %>" placeholder="Search ticket #, title, reporter, or location..." class="form-control" />
            </div>

            <div style="flex: 1; min-width: 140px;">
              <select name="status" class="form-control" onchange="this.form.submit()">
                <option value="all" <%= selectedStatus === 'all' ? 'selected' : '' %>>All Statuses</option>
                <option value="Open" <%= selectedStatus === 'Open' ? 'selected' : '' %>>Open</option>
                <option value="In Progress" <%= selectedStatus === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                <option value="Resolved" <%= selectedStatus === 'Resolved' ? 'selected' : '' %>>Resolved</option>
                <option value="Verified" <%= selectedStatus === 'Verified' ? 'selected' : '' %>>Verified</option>
                <option value="Escalated" <%= selectedStatus === 'Escalated' ? 'selected' : '' %>>Escalated</option>
              </select>
            </div>

            <div style="flex: 1; min-width: 140px;">
              <select name="category" class="form-control" onchange="this.form.submit()">
                <option value="all" <%= selectedCategory === 'all' ? 'selected' : '' %>>All Categories</option>
                <option value="Electrical" <%= selectedCategory === 'Electrical' ? 'selected' : '' %>>Electrical</option>
                <option value="Network" <%= selectedCategory === 'Network' ? 'selected' : '' %>>Network & IT</option>
                <option value="Laboratory" <%= selectedCategory === 'Laboratory' ? 'selected' : '' %>>Laboratory</option>
                <option value="Hostel" <%= selectedCategory === 'Hostel' ? 'selected' : '' %>>Hostel</option>
                <option value="Infrastructure" <%= selectedCategory === 'Infrastructure' ? 'selected' : '' %>>Infrastructure</option>
                <option value="Transport" <%= selectedCategory === 'Transport' ? 'selected' : '' %>>Transport</option>
              </select>
            </div>

            <div style="flex: 1; min-width: 140px;">
              <select name="priority" class="form-control" onchange="this.form.submit()">
                <option value="all" <%= selectedPriority === 'all' ? 'selected' : '' %>>All Priorities</option>
                <option value="Low" <%= selectedPriority === 'Low' ? 'selected' : '' %>>Low</option>
                <option value="Medium" <%= selectedPriority === 'Medium' ? 'selected' : '' %>>Medium</option>
                <option value="High" <%= selectedPriority === 'High' ? 'selected' : '' %>>High</option>
                <option value="Critical" <%= selectedPriority === 'Critical' ? 'selected' : '' %>>Critical</option>
              </select>
            </div>

            <div>
              <button type="submit" class="btn btn-primary">Filter</button>
              <% if (search || selectedStatus !== 'all' || selectedCategory !== 'all' || selectedPriority !== 'all') { %>
                <a href="/problems" class="btn btn-secondary">Reset</a>
              <% } %>
            </div>
          </form>
        </div>
      </div>

      <!-- Tickets Table -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Incident Reports & Service Orders</h3>
          <span class="badge badge-info"><%= problems.length %> Records</span>
        </div>
        <div class="card-body" style="padding: 0;">
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Ticket #</th>
                  <th>Issue Details</th>
                  <th>Location</th>
                  <th>Category / Dept</th>
                  <th>Priority</th>
                  <th>Status</th>
                  <th style="text-align: right;">Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (problems && problems.length > 0) { %>
                  <% problems.forEach(p => { %>
                    <tr>
                      <td>
                        <span style="font-family: var(--font-mono); font-weight: 700; color: var(--primary);">
                          <%= p.ticketNumber %>
                        </span>
                        <div style="font-size: 0.72rem; color: var(--text-muted);">
                          <%= new Date(p.createdAt).toLocaleDateString() %>
                        </div>
                      </td>
                      <td>
                        <a href="/problems/<%= p.id %>" style="font-weight: 700; color: var(--text-main); display: block;">
                          <%= p.title %>
                        </a>
                        <div style="font-size: 0.75rem; color: var(--text-secondary); max-width: 320px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                          <%= p.description %>
                        </div>
                        <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 0.2rem;">
                          Reported by: <%= p.reporterName %>
                        </div>
                      </td>
                      <td>
                        <div style="font-size: 0.85rem; font-weight: 600;"><%= p.building %></div>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">
                          Block <%= p.block %>, <%= p.floor %>, Room <%= p.room || 'N/A' %>
                        </div>
                      </td>
                      <td>
                        <span class="badge badge-secondary" style="font-size: 0.75rem;"><%= p.category %></span>
                        <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 0.25rem;">
                          <%= p.department ? p.department.name : 'Auto-Routing...' %>
                        </div>
                      </td>
                      <td>
                        <span class="badge badge-<%= p.priority === 'Critical' ? 'danger' : p.priority === 'High' ? 'warning' : p.priority === 'Medium' ? 'info' : 'secondary' %>">
                          <%= p.priority %>
                        </span>
                      </td>
                      <td>
                        <span class="badge badge-<%= p.status === 'Resolved' || p.status === 'Verified' ? 'success' : p.status === 'In Progress' ? 'primary' : p.status === 'Escalated' ? 'danger' : 'warning' %>">
                          <%= p.status %>
                        </span>
                      </td>
                      <td style="text-align: right;">
                        <a href="/problems/<%= p.id %>" class="btn btn-secondary btn-sm">
                          View Ticket →
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="7" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                      <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🎉</div>
                      <p>No campus issues found matching your filters. Everything is operational!</p>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </main>
  </div>
</div>

<%- include('../partials/footer') %>

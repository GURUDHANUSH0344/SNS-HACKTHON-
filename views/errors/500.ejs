<%- include('../partials/head', { pageTitle: '500 - Something Went Wrong — CAMPUS AI' }) %>

<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--bg-main); padding: 1.5rem;">
  <div class="card" style="max-width: 480px; width: 100%; text-align: center; padding: 2.5rem 2rem;">
    <div style="font-size: 3.5rem; margin-bottom: 0.5rem;">⚠️</div>
    <span class="badge badge-danger" style="font-size: 0.8rem; margin-bottom: 0.75rem;">ERROR 500</span>
    <h1 style="font-size: 1.75rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.5rem;">Something went wrong</h1>
    <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.5rem;">
      <%= typeof message !== 'undefined' ? message : 'An internal system error occurred while processing your request. Our automated diagnostics have logged this incident.' %>
    </p>
    <a href="/" class="btn btn-primary" style="width: 100%; justify-content: center;">
      Return to CAMPUS AI Portal →
    </a>
  </div>
</div>

</body>
</html>

<%- include('partials/head', { pageTitle: 'Admissions Management — CAMPUS AI' }) %>

<div class="app-layout">
  <%- include('partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('partials/navbar') %>

    <main class="content-container">
      <div class="page-header">
        <div>
          <h1 class="page-title">Admissions Management</h1>
          <p class="page-subtitle">Candidate Enrollment, Eligibility Review, and Automated Student Onboarding</p>
        </div>
        <div style="display: flex; gap: 0.5rem;">
          <button type="button" onclick="openModal('addAdmissionModal')" class="btn btn-primary btn-sm">
            + New Application
          </button>
          <button type="button" onclick="openModal('bulkUploadModal')" class="btn btn-secondary btn-sm">
            📥 Bulk Excel Import
          </button>
        </div>
      </div>

      <!-- Filters & Search -->
      <div class="card" style="margin-bottom: 1.25rem; padding: 1rem 1.25rem;">
        <form action="/admissions" method="GET" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between;">
          <div style="display: flex; gap: 1rem; flex: 1; min-width: 280px;">
            <input type="text" name="search" class="form-control" placeholder="Search by name, app no, course, or email..." value="<%= search %>" style="max-width: 360px;" />
            <select name="status" class="form-control" style="max-width: 180px;" onchange="this.form.submit()">
              <option value="all" <%= status === 'all' ? 'selected' : '' %>>All Statuses</option>
              <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>Pending Review</option>
              <option value="approved" <%= status === 'approved' ? 'selected' : '' %>>Approved</option>
              <option value="rejected" <%= status === 'rejected' ? 'selected' : '' %>>Rejected</option>
            </select>
          </div>
          <div style="display: flex; gap: 0.5rem;">
            <button type="submit" class="btn btn-primary btn-sm">Filter</button>
            <a href="/admissions" class="btn btn-secondary btn-sm">Reset</a>
          </div>
        </form>
      </div>

      <!-- Admissions Table -->
      <div class="table-container">
        <div class="table-header-tools">
          <span style="font-weight: 600; font-size: 0.875rem;">Applications List (<%= admissions.length %>)</span>
          <span style="font-size: 0.75rem; color: var(--text-muted);">Approving an application automatically provisions student ID and registers account</span>
        </div>

        <% if (admissions && admissions.length > 0) { %>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Application No</th>
                  <th>Applicant Name</th>
                  <th>Contact Details</th>
                  <th>Target Course</th>
                  <th>Merit %</th>
                  <th>Document</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% admissions.forEach(adm => { %>
                  <tr>
                    <td><strong><%= adm.applicationNo %></strong></td>
                    <td>
                      <div style="font-weight: 600;"><%= adm.name %></div>
                      <div style="font-size: 0.75rem; color: var(--text-muted);"><%= new Date(adm.createdAt).toLocaleDateString('en-IN') %></div>
                    </td>
                    <td>
                      <div><%= adm.email %></div>
                      <div style="font-size: 0.75rem; color: var(--text-muted);"><%= adm.phone %></div>
                    </td>
                    <td><%= adm.course %></td>
                    <td><strong><%= adm.marksPercentage %>%</strong></td>
                    <td>
                      <% if (adm.documentUrl) { %>
                        <a href="<%= adm.documentUrl %>" target="_blank" class="btn btn-secondary btn-sm" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;">
                          📄 View
                        </a>
                      <% } else { %>
                        <span style="font-size: 0.75rem; color: var(--text-muted);">None</span>
                      <% } %>
                    </td>
                    <td>
                      <span class="status-pill status-<%= adm.status %>">
                        <%= adm.status.toUpperCase() %>
                      </span>
                    </td>
                    <td>
                      <div style="display: flex; gap: 0.35rem;">
                        <% if (adm.status === 'pending') { %>
                          <form action="/admissions/<%= adm.id %>/approve" method="POST" style="margin: 0;" onsubmit="return confirm('Approve admission for this candidate? This will generate a Student ID and dispatch confirmation email.');">
                            <button type="submit" class="btn btn-success btn-sm" title="Approve & Enroll">
                              ✓ Approve
                            </button>
                          </form>
                          <button type="button" data-id="<%= adm.id %>" data-name="<%= adm.name %>" onclick="openRejectModal(this.dataset.id, this.dataset.name)" class="btn btn-danger btn-sm" title="Reject Application">
                            ✕ Reject
                          </button>
                        <% } else if (adm.status === 'approved') { %>
                          <span style="font-size: 0.75rem; color: var(--success); font-weight: 600;">✓ Enrolled</span>
                        <% } else { %>
                          <span style="font-size: 0.75rem; color: var(--danger); font-weight: 600;">✕ Disqualified</span>
                        <% } %>

                        <form action="/admissions/<%= adm.id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Delete record permanently?');">
                          <button type="submit" class="btn btn-secondary btn-sm" style="color: var(--danger);" title="Delete Record">
                            🗑️
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">
            <div class="empty-icon">📂</div>
            <div class="empty-title">No Admissions Found</div>
            <p class="empty-text">No candidate application records match the active filters or search terms.</p>
            <button onclick="openModal('addAdmissionModal')" class="btn btn-primary btn-sm">+ Add New Application</button>
          </div>
        <% } %>
      </div>

    </main>
  </div>
</div>

<!-- Add Admission Modal -->
<div class="modal-overlay" id="addAdmissionModal">
  <div class="modal-card">
    <div class="modal-header">
      <h3 class="modal-title">New Candidate Admission Application</h3>
      <button class="modal-close" data-dismiss="modal">✕</button>
    </div>
    <form action="/admissions" method="POST" enctype="multipart/form-data">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Full Name</label>
          <input type="text" name="name" class="form-control" placeholder="Candidate full name" required />
        </div>
        <div class="form-group" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div>
            <label class="form-label">Email Address</label>
            <input type="email" name="email" class="form-control" placeholder="candidate@email.com" required />
          </div>
          <div>
            <label class="form-label">Phone Number</label>
            <input type="text" name="phone" class="form-control" placeholder="+91 98765 43210" required />
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Course Applied For</label>
          <select name="course" class="form-control" required>
            <option value="B.Tech Computer Science & Engineering">B.Tech Computer Science & Engineering</option>
            <option value="B.Tech Artificial Intelligence & Data Science">B.Tech Artificial Intelligence & Data Science</option>
            <option value="B.Tech Electronics & Communication">B.Tech Electronics & Communication</option>
            <option value="B.Tech Mechanical Engineering">B.Tech Mechanical Engineering</option>
            <option value="M.Tech Machine Learning Systems">M.Tech Machine Learning Systems</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Merit Entrance / Qualifying Score (%)</label>
          <input type="number" step="0.1" name="marksPercentage" class="form-control" placeholder="85.5" required />
        </div>
        <div class="form-group">
          <label class="form-label">Supporting Verification Document (PDF / Image)</label>
          <input type="file" name="document" class="form-control" accept=".pdf,.png,.jpg,.jpeg" />
        </div>
        <div class="form-group">
          <label class="form-label">Remarks / Special Notes</label>
          <textarea name="remarks" class="form-control" placeholder="Merit scholarship, sports quota, or entrance exam rank..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Submit Application</button>
      </div>
    </form>
  </div>
</div>

<!-- Reject Modal -->
<div class="modal-overlay" id="rejectModal">
  <div class="modal-card">
    <div class="modal-header">
      <h3 class="modal-title">Reject Admission Application</h3>
      <button class="modal-close" data-dismiss="modal">✕</button>
    </div>
    <form id="rejectForm" method="POST">
      <div class="modal-body">
        <p style="font-size: 0.875rem; margin-bottom: 1rem;">
          You are rejecting application for <strong id="rejectApplicantName"></strong>. An official notification will be emailed to the candidate.
        </p>
        <div class="form-group">
          <label class="form-label">Disqualification Reason / Feedback</label>
          <textarea name="remarks" class="form-control" placeholder="Cutoff marks not met, incomplete documentation, etc." required></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Confirm Rejection</button>
      </div>
    </form>
  </div>
</div>

<!-- Bulk Upload Modal -->
<div class="modal-overlay" id="bulkUploadModal">
  <div class="modal-card">
    <div class="modal-header">
      <h3 class="modal-title">Bulk Import Admissions (Excel / CSV)</h3>
      <button class="modal-close" data-dismiss="modal">✕</button>
    </div>
    <form action="/admissions/bulk-upload" method="POST" enctype="multipart/form-data">
      <div class="modal-body">
        <p style="font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 1rem;">
          Upload a spreadsheet (.xlsx, .xls, .csv). Supported columns: <code>name</code>, <code>email</code>, <code>phone</code>, <code>course</code>, <code>marksPercentage</code>.
        </p>
        <div class="form-group">
          <label class="form-label">Select Spreadsheet File</label>
          <input type="file" name="file" class="form-control" accept=".xlsx,.xls,.csv" required />
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Upload & Parse</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openRejectModal(id, name) {
    document.getElementById('rejectForm').action = `/admissions/${id}/reject`;
    document.getElementById('rejectApplicantName').textContent = name;
    openModal('rejectModal');
  }
</script>

<%- include('partials/footer') %>
